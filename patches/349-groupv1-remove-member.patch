diff --git a/core/integration_tests_core/tests/remove_member_authorization.rs b/core/integration_tests_core/tests/remove_member_authorization.rs
new file mode 100644
index 0000000..aaa0d21
--- /dev/null
+++ b/core/integration_tests_core/tests/remove_member_authorization.rs
@@ -0,0 +1,190 @@
+//! #349 SECURITY — the creator-only removal policy must hold against an
+//! INSTRUMENTED client, not just a well-behaved UI.
+//!
+//! MLS gives Remove no authorization semantics: any member can craft a
+//! RemoveProposal for any other member and a plain receiver merges the commit.
+//! The app's "creator-only" checks (JS, Kotlin, and the sender-side native check)
+//! all run on the *caller's own device*, so an attacker who patches their binary
+//! skips every one of them. The only check that can actually hold is the one each
+//! RECEIVER runs against authenticated group state — that is what these tests pin.
+//!
+//! `group_remove_member_unchecked_for_test` is exactly that patched binary: the
+//! real MLS removal with the sender-side check removed. If the receive-side gate
+//! regresses, these go red and the eviction lands on honest members.
+//!
+//! Setup mirrors remove_member_spike.rs: a real 3-member GroupV1 over the harness.
+
+use integration_tests_core::TestHarness;
+use shared_traits::IdentId;
+
+/// Build a settled 3-member group created by Saro (so Saro is the creator, and
+/// Raya/Pax are ordinary members). Returns the conversation id.
+fn settled_group(harness: &mut TestHarness<3>) -> String {
+    let raya_addr = harness.raya().addr();
+    let pax_addr = harness.pax().addr();
+    let convo = harness
+        .saro()
+        .create_group_convo_v1(&[&raya_addr, &pax_addr], "grp", "desc")
+        .expect("saro create group");
+    harness.process_until_label("raya+pax join", |h| {
+        h.raya().convo_count() == 1 && h.pax().convo_count() == 1
+    });
+    harness
+        .saro()
+        .send_content(&convo, b"warm")
+        .expect("send warm");
+    harness
+        .process_until(|h| h.raya().check(&convo, b"warm") && h.pax().check(&convo, b"warm"));
+    convo
+}
+
+/// THE REVIEW'S P1. Raya is a member but not the creator. Raya's instrumented
+/// client publishes a real MLS Remove commit evicting Pax. Every honest member
+/// must refuse to apply it: Pax stays on the roster and stays in sync.
+#[test]
+fn a_non_creators_forged_remove_commit_is_rejected_by_receivers() {
+    let _ = tracing_subscriber::fmt()
+        .with_max_level(tracing::Level::INFO)
+        .with_test_writer()
+        .try_init();
+
+    let mut harness = TestHarness::<3>::new(|_, _| {});
+    let convo = settled_group(&mut harness);
+
+    let saro_epoch_before = harness.saro().group_epoch_for_test(&convo).expect("cached");
+    let pax_epoch_before = harness.pax().group_epoch_for_test(&convo).expect("cached");
+
+    // Raya (NOT the creator) forges the removal of Pax — a genuine, correctly
+    // signed MLS Remove commit; only the local policy check was skipped.
+    let pax_leaf = IdentId::new("pax".to_string());
+    harness
+        .raya()
+        .group_remove_member_unchecked_for_test(&convo, &[pax_leaf.as_str().as_bytes().to_vec()])
+        .expect("the forged commit is published — MLS itself does not stop it");
+    harness.process(std::time::Duration::from_secs(2));
+
+    // The creator must NOT have applied it: roster and epoch unchanged.
+    assert_eq!(
+        harness.saro().group_members(&convo).expect("roster").len(),
+        3,
+        "the creator's roster must still hold all 3 members — a non-creator evicted nobody"
+    );
+    assert_eq!(
+        harness.saro().group_epoch_for_test(&convo).expect("cached"),
+        saro_epoch_before,
+        "an unauthorized Remove commit must not advance the creator's epoch"
+    );
+
+    // The victim must NOT have been locked out.
+    assert_eq!(
+        harness.pax().group_epoch_for_test(&convo).expect("cached"),
+        pax_epoch_before,
+        "the targeted member must not be stranded by an unauthorized removal"
+    );
+
+    // ...and the group still works end-to-end for the victim afterwards: the
+    // creator sends, the victim decrypts. (Availability, the review's stated impact.)
+    harness
+        .saro()
+        .send_content(&convo, b"still-here")
+        .expect("creator sends after the forged removal");
+    harness.process_until_label("victim still receives", |h| {
+        h.pax().check(&convo, b"still-here")
+    });
+}
+
+/// The other half: the legitimate path must still work after the gate. The
+/// creator's removal is applied by the remaining honest member and the removed
+/// member is stranded (the #349 behaviour the PR ships).
+#[test]
+fn the_creators_removal_is_still_applied_by_other_members() {
+    let _ = tracing_subscriber::fmt()
+        .with_max_level(tracing::Level::INFO)
+        .with_test_writer()
+        .try_init();
+
+    let mut harness = TestHarness::<3>::new(|_, _| {});
+    let convo = settled_group(&mut harness);
+
+    let raya_epoch_before = harness.raya().group_epoch_for_test(&convo).expect("cached");
+
+    let pax_leaf = IdentId::new("pax".to_string());
+    harness
+        .saro()
+        .group_remove_member(&convo, &[pax_leaf.as_str().as_bytes().to_vec()])
+        .expect("the creator may remove");
+    harness.process(std::time::Duration::from_secs(2));
+
+    // Raya (an honest non-creator receiver) APPLIED the creator's commit: the gate
+    // rejects forgeries without breaking legitimate removals.
+    assert!(
+        harness.raya().group_epoch_for_test(&convo).expect("cached") > raya_epoch_before,
+        "a remaining member must apply the creator's Remove commit (epoch advances)"
+    );
+    assert_eq!(
+        harness.raya().group_members(&convo).expect("roster").len(),
+        2,
+        "the removed member is gone from a remaining member's roster"
+    );
+}
+
+/// A non-creator must not be able to evict the CREATOR either — otherwise the
+/// gate could be bypassed by first decapitating the group.
+#[test]
+fn a_non_creator_cannot_evict_the_creator() {
+    let _ = tracing_subscriber::fmt()
+        .with_max_level(tracing::Level::INFO)
+        .with_test_writer()
+        .try_init();
+
+    let mut harness = TestHarness::<3>::new(|_, _| {});
+    let convo = settled_group(&mut harness);
+
+    let saro_epoch_before = harness.saro().group_epoch_for_test(&convo).expect("cached");
+    let saro_leaf = IdentId::new("saro".to_string());
+    harness
+        .raya()
+        .group_remove_member_unchecked_for_test(&convo, &[saro_leaf.as_str().as_bytes().to_vec()])
+        .expect("published");
+    harness.process(std::time::Duration::from_secs(2));
+
+    assert_eq!(
+        harness.saro().group_epoch_for_test(&convo).expect("cached"),
+        saro_epoch_before,
+        "the creator must not apply a commit that evicts the creator"
+    );
+    assert_eq!(
+        harness.saro().group_members(&convo).expect("roster").len(),
+        3,
+        "no takeover: the roster is untouched"
+    );
+    assert_eq!(
+        harness.pax().group_members(&convo).expect("roster").len(),
+        3,
+        "the third member agrees — everyone honest stayed on the same group state"
+    );
+}
+
+/// The sender-side half: an honest (unpatched) non-creator is refused locally, so
+/// it never publishes a commit the group would drop and strand it behind.
+#[test]
+fn an_honest_non_creator_is_refused_locally() {
+    let mut harness = TestHarness::<3>::new(|_, _| {});
+    let convo = settled_group(&mut harness);
+
+    let epoch_before = harness.raya().group_epoch_for_test(&convo).expect("cached");
+    let pax_leaf = IdentId::new("pax".to_string());
+    let err = harness
+        .raya()
+        .group_remove_member(&convo, &[pax_leaf.as_str().as_bytes().to_vec()])
+        .expect_err("a non-creator's removal must fail on its own device too");
+    assert!(
+        err.to_string().contains("only the group creator"),
+        "the refusal must name the reason, got: {err}"
+    );
+    assert_eq!(
+        harness.raya().group_epoch_for_test(&convo).expect("cached"),
+        epoch_before,
+        "a refused removal must not have mutated local MLS state"
+    );
+}
diff --git a/core/integration_tests_core/tests/remove_member_spike.rs b/core/integration_tests_core/tests/remove_member_spike.rs
new file mode 100644
index 0000000..b92733a
--- /dev/null
+++ b/core/integration_tests_core/tests/remove_member_spike.rs
@@ -0,0 +1,99 @@
+//! #349 EXPERIMENT — prove GroupV1 can remove OTHER members.
+//!
+//! The open question before committing to the full remove-then-add recovery
+//! (#349/#350) is purely mechanical: does a from-scratch MLS `remove_members`
+//! in GroupV1 (a) produce a real epoch-advancing Commit the remaining members
+//! apply, and (b) actually LOCK OUT the removed member (they can no longer
+//! decrypt subsequent traffic)? GroupV1 had no remove path at all, so this is
+//! the trivial experiment that de-risks the feature.
+//!
+//! Setup mirrors test_graph_hiding_epoch_stability.rs: a real 3-member GroupV1.
+
+use integration_tests_core::TestHarness;
+use shared_traits::IdentId;
+
+#[test]
+fn removing_a_member_advances_the_epoch_and_locks_them_out() {
+    let _ = tracing_subscriber::fmt()
+        .with_max_level(tracing::Level::INFO)
+        .with_test_writer()
+        .try_init();
+
+    let mut harness = TestHarness::<3>::new(|_, _| {});
+    let raya_addr = harness.raya().addr();
+    let pax_addr = harness.pax().addr();
+
+    // Saro creates a real named group with Raya + Pax; settle both joins.
+    let convo = harness
+        .saro()
+        .create_group_convo_v1(&[&raya_addr, &pax_addr], "grp", "desc")
+        .expect("saro create group");
+    harness.process_until_label("raya+pax join", |h| {
+        h.raya().convo_count() == 1 && h.pax().convo_count() == 1
+    });
+
+    // Warm-up so the group is fully settled on all three sides.
+    harness.saro().send_content(&convo, b"warm").expect("send warm");
+    harness.process_until(|h| {
+        h.raya().check(&convo, b"warm") && h.pax().check(&convo, b"warm")
+    });
+
+    // All three are members before the removal.
+    assert_eq!(
+        harness.saro().group_members(&convo).expect("roster").len(),
+        3,
+        "group starts with 3 members"
+    );
+    let epoch_before = harness
+        .saro()
+        .group_epoch_for_test(&convo)
+        .expect("group cached on saro");
+
+    // The MLS leaf credential is the member's short id ("pax"), NOT the account
+    // address hash — so we target that. (Mapping account -> leaf credential is
+    // the client facade's job in production; the experiment targets the leaf
+    // directly to isolate the MLS mechanic.) `group_remove_member` takes raw leaf
+    // credential contents since the DelegateCredential fix.
+    let pax_leaf = IdentId::new("pax".to_string());
+
+    // ---- REMOVE Pax (a real MLS Remove commit) ---------------------------
+    harness
+        .saro()
+        .group_remove_member(&convo, &[pax_leaf.as_str().as_bytes().to_vec()])
+        .expect("saro remove pax");
+
+    // (a) The removing member's OWN state: the commit merged locally, advancing
+    // the epoch and dropping pax from the roster. (We assert saro's view — saro
+    // never has to decrypt anything it can't, so this is crash-free regardless
+    // of how the harness treats a locked-out peer.)
+    let epoch_after = harness
+        .saro()
+        .group_epoch_for_test(&convo)
+        .expect("group cached on saro");
+    assert!(
+        epoch_after > epoch_before,
+        "removing a member must advance the MLS epoch (before={epoch_before}, after={epoch_after})"
+    );
+    assert_eq!(
+        harness.saro().group_members(&convo).expect("roster").len(),
+        2,
+        "saro's roster drops to 2 after removing pax"
+    );
+
+    // (b) THE LOCKOUT, proven WITHOUT forcing pax to decrypt (which would make
+    // the harness's `handle_payload(..).unwrap()` panic — itself evidence of the
+    // lockout): pax never received the epoch-advancing commit's new secrets, so
+    // pax is stranded on the old epoch while saro moved forward.
+    let pax_epoch = harness
+        .pax()
+        .group_epoch_for_test(&convo)
+        .expect("group cached on pax");
+    assert_eq!(
+        pax_epoch, epoch_before,
+        "the removed member stays stranded on the pre-removal epoch (locked out)"
+    );
+    assert!(
+        epoch_after > pax_epoch,
+        "saro advanced past pax's epoch — pax can no longer decrypt group traffic"
+    );
+}
diff --git a/crates/generic-chat/src/client.rs b/crates/generic-chat/src/client.rs
