--- a/crates/generic-chat/src/client.rs
+++ b/crates/generic-chat/src/client.rs
@@ -281,6 +281,46 @@ where
             .map_err(Into::into)
     }
 
+    /// #349: remove other accounts' devices from a group (creator-gated at the
+    /// app layer). Resolves each account to its signer (installation) ids and
+    /// removes every matching MLS leaf in one epoch-advancing commit. Mirrors
+    /// [`Self::add_group_members`].
+    pub fn remove_group_member(
+        &mut self,
+        convo_id: &str,
+        accounts: &[AccountAddressRef],
+    ) -> Result<(), ClientError> {
+        // A GroupV1 leaf carries a serialized DelegateCredential — NOT the account
+        // address or the signer id (that mismatch was the bug the on-device test caught).
+        // Resolve each target account to its actual leaf credential(s) the same way
+        // `group_members` maps a leaf → account (via the directory), then remove by the
+        // credential bytes the leaf actually holds.
+        let matches = |id: &str| accounts.iter().any(|a| id.eq_ignore_ascii_case(a));
+        let credentials = self.core.lock().group_members(convo_id)?;
+        let wanted: Vec<Vec<u8>> = credentials
+            .into_iter()
+            .filter(|cred| {
+                roster_member(&self.directory, cred).is_some_and(|m| {
+                    m.account
+                        .as_ref()
+                        .is_some_and(|acc| matches(acc.as_str()))
+                        || matches(m.local_identity.as_str())
+                })
+            })
+            .collect();
+        if wanted.is_empty() {
+            return Err(libchat::ChatError::Protocol(
+                "remove_group_member: no group member matched the given account(s)".into(),
+            )
+            .into());
+        }
+
+        self.core
+            .lock()
+            .group_remove_member(convo_id, &wanted)
+            .map_err(Into::into)
+    }
+
     /// Leave a group conversation: stage the removal of THIS client from the
     /// group's roster. Like [`Self::add_group_members`] the removal runs as a
     /// consensus round — it is merged by the group's next commit, not when this
