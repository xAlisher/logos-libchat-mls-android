@@ -0,0 +1,11 @@
+-- MLS provider state.
+--
+-- The MLS provider keeps its group state (and the private key material it
+-- references) in an in-memory key-value store. This single row holds that
+-- store serialized verbatim, so conversations survive a restart. It is secret
+-- material, hence this encrypted database rather than a sidecar file.
+CREATE TABLE IF NOT EXISTS mls_state (
+    id INTEGER PRIMARY KEY CHECK (id = 1),
+    state BLOB NOT NULL,
+    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now'))
+);
