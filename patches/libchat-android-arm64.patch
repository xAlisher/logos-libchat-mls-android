+/// Serializes openmls' own key-value store verbatim.
+///
+/// Layout (matching `MemoryStorage::serialize`, which upstream gates behind its
+/// test-only `test-utils` feature): a big-endian `u64` entry count, then per
+/// entry a `u64` key length, a `u64` value length, the key bytes and the value
+/// bytes. Re-implemented over the public `values` map so the persistence path
+/// carries no test-only feature — and so no `StorageProvider` has to be
+/// hand-written.
+pub fn serialize_storage(storage: &MemoryStorage) -> Result<Vec<u8>, ChatError> {
+    let values = storage
+        .values
+        .read()
+        .map_err(|_| ChatError::generic("mls storage lock poisoned"))?;
+
+    let mut out = Vec::new();
+    out.extend_from_slice(&(values.len() as u64).to_be_bytes());
+    for (key, value) in values.iter() {
+        out.extend_from_slice(&(key.len() as u64).to_be_bytes());
+        out.extend_from_slice(&(value.len() as u64).to_be_bytes());
+        out.extend_from_slice(key);
+        out.extend_from_slice(value);
+    }
+    Ok(out)
+}
+
+/// Rebuilds a `MemoryStorage` from a blob written by [`serialize_storage`].
+/// A malformed blob is an error rather than a silent reset: dropping the MLS
+/// state would strand every conversation the store already knows about.
+pub fn deserialize_storage(blob: &[u8]) -> Result<MemoryStorage, ChatError> {
+    fn take<'a>(rest: &mut &'a [u8], n: usize) -> Result<&'a [u8], ChatError> {
+        if rest.len() < n {
+            return Err(ChatError::generic("truncated mls state blob"));
+        }
+        let (head, tail) = rest.split_at(n);
+        *rest = tail;
+        Ok(head)
+    }
+
+    fn take_u64(rest: &mut &[u8]) -> Result<u64, ChatError> {
+        let bytes: [u8; 8] = take(rest, 8)?
+            .try_into()
+            .map_err(|_| ChatError::generic("truncated mls state blob"))?;
+        Ok(u64::from_be_bytes(bytes))
+    }
+
+    let mut rest = blob;
+    let count = take_u64(&mut rest)?;
+    let mut map = std::collections::HashMap::new();
+    for _ in 0..count {
+        let key_len = take_u64(&mut rest)? as usize;
+        let value_len = take_u64(&mut rest)? as usize;
+        let key = take(&mut rest, key_len)?.to_vec();
+        let value = take(&mut rest, value_len)?.to_vec();
+        map.insert(key, value);
+    }
+
+    let storage = MemoryStorage::default();
+    {
+        let mut values = storage
+            .values
+            .write()
+            .map_err(|_| ChatError::generic("mls storage lock poisoned"))?;
+        *values = map;
+    }
+    Ok(storage)
+}
+
