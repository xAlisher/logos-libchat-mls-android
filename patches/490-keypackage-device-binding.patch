@@ -336,6 +336,19 @@ where
                 .credential()
                 .serialized_content()
                 .to_vec();
+            // SECURITY (GHSA-xxgx-7757-3qq6): `member_id` above is read from the
+            // package's OWN credential and was never checked equal to `member` (the
+            // signer we asked for). A malicious registry / poisoned BLE cache can return
+            // an attacker's validated package for a victim's id, adding the attacker's
+            // leaf under the victim's identity (confidentiality break + attribution
+            // spoof). A signer id is hex(Ed25519 verifying key), so bind the leaf's
+            // signature_key (not the spoofable credential bytes) to the requested id.
+            let leaf_key = hex::encode(keypkg.leaf_node().signature_key().as_slice());
+            if leaf_key != member.as_str() {
+                return Err(ChatError::generic(format!(
+                    "key package for {member} is bound to a different signing key ({leaf_key})"
+                )));
+            }
             invites.push((member_id, member.to_string(), kp_bytes));
         }
 
