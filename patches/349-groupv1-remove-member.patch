+impl GroupV1Convo {
+    // #349: remove one or more members. Symmetric to add_member, but produces an
+    // MLS RemoveProposal+Commit (no Welcome) that advances the epoch and ejects the
+    // targets; every remaining member applies the commit and the removed leaf can
+    // no longer decrypt.
+    //
+    // `enforce_creator` is the sender-side half of the creator-only policy. It is
+    // NOT the security boundary — `process_frame`'s receive-side check is, because
+    // an instrumented client simply deletes this one. It is here so an honest client
+    // fails loudly instead of publishing a Commit every other member will drop,
+    // which would advance only its own epoch and strand it out of the group.
+    fn remove_member_impl<S: ExternalServices>(
+        &mut self,
+        cx: &mut ServiceContext<S>,
+        targets: &[Vec<u8>],
+        enforce_creator: bool,
+    ) -> Result<(), ChatError> {
+        if targets.is_empty() {
+            return Ok(());
+        }
+
+        if enforce_creator {
+            let own = self
+                .mls_group
+                .own_leaf_node()
+                .map(|leaf| leaf.credential().serialized_content().to_vec());
+            match (self.creator_credential(), own) {
+                (Some(creator), Some(own)) if creator == own => {}
+                // Distinguish the two refusals: a group created before #349 carries no
+                // creator in its context, so NO member can be authorized on receipt and
+                // removal is unavailable for that group — a different fact from "you are
+                // not the creator", and the app surfaces it differently.
+                (None, _) => {
+                    return Err(ChatError::Protocol(
+                        "remove_member: this group has no recorded creator (created before \
+                         member removal was supported), so removal is unavailable"
+                            .into(),
+                    ));
+                }
+                _ => {
+                    return Err(ChatError::Protocol(
+                        "remove_member: only the group creator may remove members".into(),
+                    ));
+                }
+            }
+        }
+
+        // Targets are LEAF CREDENTIAL contents (serialized DelegateCredential bytes) — the
+        // exact `serialized_content()` an MLS leaf carries. The caller (client facade)
+        // resolves the account → its leaf credential(s) via the directory, because the
+        // account address and the signer id are NOT the leaf credential (that mismatch was
+        // the bug the on-device test caught). Match by raw bytes.
+        let leaves: Vec<LeafNodeIndex> = self
+            .mls_group
+            .members()
+            .filter(|m| {
+                targets
+                    .iter()
+                    .any(|t| t.as_slice() == m.credential.serialized_content())
+            })
+            .map(|m| m.index)
+            .collect();
+        if leaves.is_empty() {
+            return Err(ChatError::Protocol(
+                "remove_member: no matching group member for the given credential(s)".into(),
+            ));
+        }
+
+        // NB: never `.unwrap()` an MLS op on a worker thread — surface the error.
+        let (commit, _welcome, _group_info) = self
+            .mls_group
+            .remove_members(&cx.mls_provider, &cx.mls_identity, &leaves)
+            .map_err(ChatError::generic)?;
+
+        self.mls_group
+            .merge_pending_commit(&cx.mls_provider)
+            .map_err(ChatError::generic)?;
+
+        self.send_payload(cx, commit.to_bytes()?)
+    }
