+    /// first time (`last == None`), else incremental from the last catch-up minus a
+    /// margin, floored at 30 days (the store peer's retention bound). Keeps the
+    /// periodic re-pull from re-replaying 30 days of history every tick.
+    fn catchup_start_ns(last: Option<u64>, now: u64) -> u64 {
+        const DAY_NS: u64 = 24 * 3600 * 1_000_000_000;
+        const MARGIN_NS: u64 = 60 * 1_000_000_000;
+        let floor = now.saturating_sub(30 * DAY_NS);
+        match last {
+            None => floor,
+            Some(t) => t.saturating_sub(MARGIN_NS).max(floor),
+        }
+    }
+
+    /// Replay history for `content_topic` from the store `peer` over the window
+    /// [`start_ns`, now] so a client whose filter subscription was dormant still
+    /// receives what it missed (#228 missed-welcome catch-up; #211 periodic pull).
+    /// Best-effort — never fails the caller. Runs on a detached thread; each
+    /// recovered message is fed through the SAME mapper + inbound fan-out as a live
+    /// message, so MLS de-dupes replays and an already-seen message is benign.
+    fn store_catch_up<F>(
+        node: &LogosNodeCtx,
+        peer: &str,
+        content_topic: &str,
+        start_ns: u64,
+        subscribers: &SubscriberList<T>,
+        map: &Arc<Mutex<F>>,
+        seen: &Arc<Mutex<std::collections::HashSet<u64>>>,
+    ) where
+        T: Clone,
+        F: FnMut(WakuEvent) -> Option<T>,
+    {
+        use std::hash::{Hash, Hasher};
+        if peer.is_empty() {
+            return; // preset/fleet mode has no designated store peer
+        }
+        use std::time::{SystemTime, UNIX_EPOCH};
+        let now_ns = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|d| d.as_nanos() as u64)
+            .unwrap_or(0);
+        // #211: [start_ns, end_ns] window — start supplied by the caller (30-day
+        // sweep on first catch-up, incremental on periodic re-pulls).
+        let end_ns = now_ns.saturating_add(3600 * 1_000_000_000);
+        // PROVEN on-device (2026-07-26): query by contentTopics only (NO
+        // pubsubTopic — that filter silently returns 0) plus a time window.
+        let query = serde_json::json!({
+            "requestId": new_request_id(),
+            "includeData": true,
+            "contentTopics": [content_topic],
+            "timeStart": start_ns,
+            "timeEnd": end_ns,
+            "paginationLimit": 50,
+            "paginationForward": false,
+        })
+        .to_string();
+
+        // One retry: the first subscribe can land before the store peer connection
+        // is fully up; the 15s request timeout usually absorbs the dial.
+        let mut resp = None;
+        for attempt in 0..2 {
+            match node.store_query(&query, peer, 15_000) {
+                Ok(r) => {
+                    resp = Some(r);
+                    break;
+                }
+                Err(e) => {
+                    debug!("store catch-up query failed (attempt {attempt}): {e}");
+                    if attempt == 0 {
+                        thread::sleep(Duration::from_secs(3));
+                    }
+                }
+            }
+        }
+        let Some(resp) = resp else { return };
+        let parsed: StoreResponse = match serde_json::from_str(&resp) {
+            Ok(p) => p,
+            Err(e) => {
+                debug!("store catch-up parse failed: {e}");
+                return;
+            }
+        };
+        if parsed.status_code != Some(200) {
+            debug!("store catch-up non-200: {:?}", parsed.status_code);
+            return;
+        }
+        let messages = parsed.messages.unwrap_or_default();
+        let mut replayed = 0usize;
+        for entry in messages {
+            let Some(m) = entry.message else { continue };
+            let (Some(ct), Some(payload)) = (m.content_topic, m.payload) else {
+                continue;
+            };
+            // #211: skip a message this session's catch-up already replayed, so the
+            // overlapping re-query window doesn't re-feed it to the lib every tick.
+            // Key on (topic, raw payload) — dedup before decode, cheap + exact.
+            let key = {
+                let mut h = std::collections::hash_map::DefaultHasher::new();
+                ct.hash(&mut h);
+                match &payload {
+                    WakuPayload::Base64(s) => s.hash(&mut h),
+                    WakuPayload::Bytes(b) => b.hash(&mut h),
+                }
+                h.finish()
+            };
+            match seen.lock() {
+                Ok(mut g) => {
+                    if !g.insert(key) {
+                        continue; // already replayed this session
+                    }
+                }
+                Err(_) => return,
+            }
+            // Rebuild a plain message-received event and run it through the SAME
+            // mapper the live callback uses (content-topic filter + payload
+            // decode), then fan out to the inbound queue like a live message.
+            let event = WakuEvent {
+                event_type: "message_received".to_string(),
+                message: Some(ReceivedMessage {
+                    content_topic: ct,
+                    payload,
+                }),
+                channel_id: None,
+                payload: None,
+            };
+            let item = {
+                let mut m = match map.lock() {
+                    Ok(g) => g,
+                    Err(_) => return,
+                };
+                m(event)
+            };
+            let Some(item) = item else { continue };
+            let mut guard = match subscribers.lock() {
+                Ok(g) => g,
+                Err(_) => return,
+            };
+            guard.retain(|tx| match tx.try_send(item.clone()) {
+                Ok(()) => true,
+                Err(crossbeam_channel::TrySendError::Full(_)) => true,
+                Err(crossbeam_channel::TrySendError::Disconnected(_)) => false,
+            });
+            replayed += 1;
+        }
+        if replayed > 0 {
+            info!("store catch-up: replayed {replayed} message(s) for {content_topic}");
+        }
+    }
 }
