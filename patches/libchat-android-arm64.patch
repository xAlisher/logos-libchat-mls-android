+/// #239: Alice and Bob have never met online — SEPARATE registries. Alice can only
+/// add Bob after IMPORTING his contact card (the hand-off that will travel over
+/// BLE). Then the MLS 1:1 create -> welcome -> join -> message all work with no
+/// shared directory lookup, proving the offline-bootstrap primitives.
+#[test]
+fn offline_bootstrap_via_imported_contact() {
+    let bus = MessageBus::default();
+    let alice_reg = EphemeralRegistry::new();
+    let bob_reg = EphemeralRegistry::new();
+
+    let (raya, raya_events) =
+        create_test_client(bus.clone(), bob_reg.clone()).expect("bob client");
+    let (mut saro, _saro_events) =
+        create_test_client(bus.clone(), alice_reg.clone()).expect("alice client");
+    let bob_addr = raya.addr().to_string();
+
+    // Alice's registry has never seen Bob -> a create must fail.
+    assert!(
+        saro.create_direct_conversation(&bob_addr).is_err(),
+        "create should fail before Bob's card is imported"
+    );
+
+    // The BLE hand-off is MUTUAL: each side imports the other's card — Alice needs
+    // Bob's to create the group, and Bob needs Alice's to verify her as the sender
+    // of messages that follow.
+    let (b_acct, b_dev, b_kp, b_bp, b_sig) = bob_reg.export_contact().expect("bob exports a card");
+    assert_eq!(b_acct, bob_addr, "card account matches Bob's address");
+    alice_reg
+        .import_contact(&b_acct, &b_dev, b_kp, b_bp, b_sig)
+        .expect("alice imports bob's verified card");
+    let (a_acct, a_dev, a_kp, a_bp, a_sig) = alice_reg.export_contact().expect("alice exports a card");
+    bob_reg
+        .import_contact(&a_acct, &a_dev, a_kp, a_bp, a_sig)
+        .expect("bob imports alice's verified card");
+
+    // Now the offline create succeeds using ONLY the imported data.
+    let convo_id = saro
+        .create_direct_conversation(&bob_addr)
+        .expect("offline create after import");
+
+    // Bob joins from the welcome (delivered here over the shared bus — the stand-in
+    // for the BLE flood the app performs).
+    expect_event(&raya_events, "ConversationStarted", |e| match e {
+        Event::ConversationStarted { convo_id, .. } => Ok(convo_id),
+        other => Err(other),
+    });
+
+    // A message round-trips A -> B over the freshly bootstrapped conversation.
+    saro.send_message(&convo_id, b"offline-hello").expect("send");
+    expect_event(&raya_events, "MessageReceived", |e| match e {
+        Event::MessageReceived { content, .. } => {
+            assert_eq!(content.as_slice(), b"offline-hello");
+            Ok(())
+        }
+        other => Err(other),
+    });
+}
