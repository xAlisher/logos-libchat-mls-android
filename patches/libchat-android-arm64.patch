@@ -21,13 +21,87 @@ pub struct MlsEphemeralPqProvider {
 
 impl MlsEphemeralPqProvider {
     pub fn new() -> Result<Self, CryptoError> {
+        Self::from_storage(MemoryStorage::default())
+    }
+
+    /// Builds the provider over an already populated storage — the restore path
+    /// for a `MemoryStorage` rehydrated from a persisted blob (see
+    /// [`deserialize_storage`]). Only the crypto provider is fresh; every MLS
