+/// #437 security: may an incoming re-add welcome REPLACE our existing group state?
+///
+/// Replacement — adopting a strictly-newer-epoch welcome for a group we already hold
+/// — is a #350 recovery, and only the creator drives one (remove-then-add). So it is
+/// allowed only when the welcome's authenticated author (`StagedWelcome::welcome_sender`,
+/// whose signature openmls has verified) signed with the SAME key as the `creator`
+/// recorded in our existing group's authenticated group-context metadata.
+///
+/// The recorded `creator` is a signer id = `hex(creator's Ed25519 verifying key)` (the
+/// leaf `BasicCredential`), so we decode it and compare against the author's raw
+/// `signature_key`. Binding to the key, not the credential bytes, is what makes this
+/// unforgeable: a peer can copy the creator's id into a credential, but cannot sign a
+/// leaf with the creator's private key, so its `signature_key` will not match. A
+/// `creator == None` (pre-#349 group / 1-1 delegate) or an un-decodable creator id fails
+/// closed: never replace, so a forged/replayed higher-epoch welcome cannot clobber a
+/// group that has no usable creator anchor.
+fn replace_authorized(creator: Option<&[u8]>, author_key: &[u8]) -> bool {
+    let Some(creator) = creator else {
+        return false;
+    };
+    match std::str::from_utf8(creator)
+        .ok()
+        .and_then(|s| hex::decode(s).ok())
+    {
+        Some(creator_key) => !creator_key.is_empty() && creator_key == author_key,
+        None => false,
+    }
+}
