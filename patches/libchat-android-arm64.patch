+// #348: the epoch-desync detector's decision logic (`stall_step`) in isolation —
+// no MLS/group state. Locks the two properties that matter: transient
+// out-of-order does NOT trip it, and a persistent gap fires exactly once.
+#[cfg(test)]
+mod stall_tests {
+    use super::{stall_step, FUTURE_STALL_THRESHOLD};
+
+    // Feed a sequence of (committed, buffered) observations; return the count of
+    // frames on which epoch_desync fired, plus the final (stall, flagged).
+    fn run(seq: &[(bool, bool)]) -> (u32, (u32, bool)) {
+        let mut stall = 0u32;
+        let mut flagged = false;
+        let mut fired = 0u32;
+        for &(committed, buffered) in seq {
+            let s = stall_step(stall, flagged, committed, buffered);
+            stall = s.stall;
+            flagged = s.flagged;
+            if s.epoch_desync {
+                fired += 1;
+            }
+        }
+        (fired, (stall, flagged))
+    }
+
+    // Transient out-of-order: a few future frames, then the bridging commit lands
+    // BEFORE the threshold → never fires, and the commit resets the stall.
+    #[test]
+    fn transient_reorder_never_fires() {
+        let n = (FUTURE_STALL_THRESHOLD - 1) as usize;
+        let mut seq = vec![(false, true); n]; // n future-buffered (< threshold)
+        seq.push((true, false)); // commit advances us
+        let (fired, (stall, flagged)) = run(&seq);
+        assert_eq!(fired, 0, "transient reorder must not flag desync");
+        assert_eq!((stall, flagged), (0, false), "commit resets the stall");
+    }
+
+    // Persistent gap: threshold future frames with no commit → fires EXACTLY once
+    // (edge-triggered), and stays quiet on further stalled frames.
+    #[test]
+    fn persistent_gap_fires_once() {
+        let extra = 3usize;
+        let seq = vec![(false, true); FUTURE_STALL_THRESHOLD as usize + extra];
+        let (fired, (_stall, flagged)) = run(&seq);
+        assert_eq!(fired, 1, "desync must fire exactly once at the threshold");
+        assert!(flagged, "stays flagged after firing (no re-spam)");
+    }
+
+    // Recovery: after firing, a commit re-arms; a second persistent gap fires again.
+    #[test]
+    fn recovers_and_can_refire_after_commit() {
+        let gap = || vec![(false, true); FUTURE_STALL_THRESHOLD as usize];
+        let mut seq = gap();
+        seq.push((true, false)); // recovered (re-add / caught-up commit)
+        seq.extend(gap()); // desync again later
+        let (fired, _) = run(&seq);
+        assert_eq!(fired, 2, "a commit re-arms the edge trigger");
+    }
+
+    // Frames that are neither commit nor future-buffer (normal current-epoch
+    // traffic) don't move the counter.
+    #[test]
+    fn current_epoch_frames_are_inert() {
+        let (fired, (stall, _)) = run(&[(false, false); 20]);
+        assert_eq!((fired, stall), (0, 0), "in-sync traffic never stalls");
     }
 }
