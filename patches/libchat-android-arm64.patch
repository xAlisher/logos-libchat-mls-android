new file mode 100644
index 0000000..b02bbd0
--- /dev/null
+++ b/extensions/logos-delivery-rust/examples/channel_repair.rs
@@ -0,0 +1,115 @@
+//! Role-based delivery peer for the SDS reliable-channel repair proof
+//! (logos-chat-android#211). ONE node per process (nwaku keeps process-global
+//! state, so multiple nodes must live in separate processes).
+//!
+//! Usage:
+//!   channel_repair recv <topic> <port>
+//!       Subscribe and print `## GOT <utf8>` for every message, forever.
+//!   channel_repair send <topic> <port> <delay_m0_s> <delay_m1_s>
+//!       Subscribe, then at t=<delay_m0> publish "M0-live" and at t=<delay_m1>
+//!       publish "M1-while-offline"; then stay alive so SDS keeps retransmitting
+//!       the unacked message (that retransmission is the repair mechanism).
+//!
+//! Transport is chosen by the migrated delivery layer: SDS reliable channels by
+//! default, plain relay/filter when LOGOS_DELIVERY_PLAIN=1 (for the A/B contrast).
+//!
+//! Driven by scripts/channel-repair-proof.sh on-device. Requires LD_LIBRARY_PATH
+//! at liblogosdelivery.so + librln.so.
+
+use std::io::Write;
+use std::time::Duration;
+
+use logos_delivery::{P2pConfig, ThreadedDeliveryWrapper, WakuEvent};
+
+fn say(s: &str) {
+    println!("{s}");
+    let _ = std::io::stdout().flush();
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let role = args.get(1).cloned().unwrap_or_default();
+    let topic = args.get(2).cloned().expect("usage: <role> <topic> <port> ...");
+    let port: u16 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(0);
+
+    // Channels are opt-in (LOGOS_DELIVERY_CHANNELS=1); plain relay/filter is the
+    // default — mirrors the gating in ThreadedDeliveryWrapper.
+    let channels = matches!(
+        std::env::var("LOGOS_DELIVERY_CHANNELS").as_deref(),
+        Ok("1") | Ok("true")
+    );
+    let plain = !channels;
+
+    let log_level = std::env::var("LOGLEVEL").unwrap_or_else(|_| "ERROR".into());
+    let want = topic.clone();
+    let mut node = ThreadedDeliveryWrapper::<String>::start(
+        P2pConfig {
+            port,
+            log_level,
+            ..Default::default()
+        },
+        move |ev: WakuEvent| {
+            let m = ev.into_received()?;
+            if m.content_topic() != want {
+                return None;
+            }
+            String::from_utf8(m.into_payload()?).ok()
+        },
+    )
+    .expect("node start");
+    node.subscribe(&topic).expect("subscribe");
+    let rx = node.inbound_queue();
+
+    say(&format!(
+        "## READY role={role} port={port} transport={}",
+        if plain { "plain" } else { "sds-channels" }
+    ));
+
+    match role.as_str() {
+        "recv" => loop {
+            if let Ok(m) = rx.recv_timeout(Duration::from_millis(500)) {
+                say(&format!("## GOT {m}"));
+            }
+        },
+        // Interactive: drain inbound in a thread, publish on `pub <text>` from
+        // stdin. Lets an external orchestrator control exact publish timing.
+        "peer" => {
+            std::thread::spawn(move || loop {
+                if let Ok(m) = rx.recv_timeout(Duration::from_millis(500)) {
+                    say(&format!("## GOT {m}"));
+                }
+            });
+            let stdin = std::io::stdin();
+            let mut line = String::new();
+            loop {
+                line.clear();
+                if std::io::BufRead::read_line(&mut stdin.lock(), &mut line).unwrap_or(0) == 0 {
+                    break;
+                }
+                let cmd = line.trim();
+                if let Some(text) = cmd.strip_prefix("pub ") {
+                    match node.publish(&topic, text.as_bytes()) {
+                        Ok(()) => say(&format!("## PUBLISHED {text}")),
+                        Err(e) => say(&format!("## PUBERR {e}")),
+                    }
+                } else if cmd == "quit" {
+                    break;
+                }
+            }
+        }
+        "send" => {
+            let d0: u64 = args.get(4).and_then(|s| s.parse().ok()).unwrap_or(20);
+            let d1: u64 = args.get(5).and_then(|s| s.parse().ok()).unwrap_or(45);
+            std::thread::sleep(Duration::from_secs(d0));
+            node.publish(&topic, b"M0-live").expect("publish M0");
+            say("## PUBLISHED M0-live");
+            std::thread::sleep(Duration::from_secs(d1.saturating_sub(d0)));
+            node.publish(&topic, b"M1-while-offline").expect("publish M1");
+            say("## PUBLISHED M1-while-offline");
+            // Stay alive so SDS keeps retransmitting the unacked M1.
+            std::thread::sleep(Duration::from_secs(120));
+        }
+        _ => eprintln!("usage: channel_repair <send|recv> <topic> <port> [d0 d1]"),
+    }
+    std::process::exit(0);
+}
