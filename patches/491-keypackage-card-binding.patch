+    /// GHSA-xxgx-7757-3qq6: the exact case prior review missed — an IN-SET device
+    /// id paired with a key package the attacker controls. The account/device
+    /// checks pass; only the device signature over the publication catches it.
+    #[test]
+    fn keypackage_publication_must_be_signed_by_the_requested_device() {
+        use crypto::Ed25519SigningKey;
+
+        let device = Ed25519SigningKey::generate();
+        let device_id = hex::encode(device.verifying_key().as_ref());
+        let set = DeviceSet {
+            lamport: 0,
+            devices: vec![device_id.clone()],
+        };
+
+        let key_package = b"opaque-key-package-bytes".to_vec();
+        let payload = encode_payload(1_700_000_000_000, &key_package);
+        let good_sig = device.sign(&payload);
+
+        // Genuine card: the device signed its own publication -> accepted, and we
+        // recover exactly the key package it published.
+        let got = verify_keypackage_publication(&set, &device_id, &payload, good_sig.as_ref())
+            .expect("genuine publication should verify");
+        assert_eq!(got, key_package);
+
+        // Attacker swaps in their own key package, signed with THEIR key, but keeps
+        // the genuine endorsed device id: in-set + account checks pass, signature
+        // does not -> rejected.
+        let attacker = Ed25519SigningKey::generate();
+        let evil_payload = encode_payload(1_700_000_000_000, b"attacker-key-package");
+        let evil_sig = attacker.sign(&evil_payload);
+        assert!(
+            verify_keypackage_publication(&set, &device_id, &evil_payload, evil_sig.as_ref())
+                .is_err(),
+            "a publication signed by another key must be rejected"
+        );
+
+        // A device the account never endorsed is rejected outright.
+        let outsider = hex::encode(Ed25519SigningKey::generate().verifying_key().as_ref());
+        assert!(
+            verify_keypackage_publication(&set, &outsider, &payload, good_sig.as_ref()).is_err(),
+            "a device outside the account's set must be rejected"
+        );
+    }
