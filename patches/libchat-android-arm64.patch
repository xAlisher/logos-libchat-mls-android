diff --git a/core/integration_tests_core/tests/test_graph_hiding.rs b/core/integration_tests_core/tests/test_graph_hiding.rs
new file mode 100644
index 0000000..7b7374b
--- /dev/null
+++ b/core/integration_tests_core/tests/test_graph_hiding.rs
@@ -0,0 +1,52 @@
+//! #graph-hiding Phase 1 (#336/#338): the sealed global-topic path must deliver to a
+//! conversation that is NOT currently cached — the store-catch-up-into-a-fresh-app
+//! path (#211) whose absence caused on-device "no delivery" before the route_index fix.
+//!
+//! We settle a 1:1, then EVICT the receiver's in-memory conversation cache (keeping the
+//! persistent route_index, exactly as after a restart before the convo is re-opened).
+//! A subsequent message must still arrive, which can only happen via the slow path:
+//! route_index[route_tag] -> load_convo -> unseal -> dispatch.
+
+use integration_tests_core::TestHarness;
+use tracing::info;
+
+#[test]
+fn sealed_delivery_to_uncached_convo_via_route_index() {
+    let _ = tracing_subscriber::fmt()
+        .with_max_level(tracing::Level::INFO)
+        .with_test_writer()
+        .try_init();
+
+    const WARMUP: &[u8] = b"hello";
+    const AFTER_EVICT: &[u8] = b"catchup-please";
+
+    let mut harness = TestHarness::<2>::new(|_, _| {});
+
+    // Saro opens a 1:1 with Raya; settle until Raya has joined.
+    let raya_addr = harness.raya().addr();
+    let convo_id = harness
+        .saro()
+        .create_direct_convo_v1(&[&raya_addr])
+        .expect("saro create direct convo");
+    harness.process_until_label("join", |h| h.raya().convo_count() == 1);
+
+    // Warm-up message so the convo is fully settled on both sides.
+    harness.saro().send_content(&convo_id, WARMUP).expect("send warmup");
+    harness.process_until(|h| h.raya().check(&convo_id, WARMUP));
+
+    // EVICT Raya's in-memory convo cache — the convo now lives only in the store +
+    // persistent route_index, NOT cached_convos (the restarted-but-not-opened state).
+    // (`convo_count` reads the store, so it stays 1; the point is the *cache* is empty,
+    // forcing inbound routing through the slow path.)
+    harness.raya().clear_convo_cache_for_test();
+
+    // Saro sends again; Raya must receive it via the route_index slow path.
+    info!(target: "chat", "Saro -> (to uncached Raya): {AFTER_EVICT:?}");
+    harness.saro().send_content(&convo_id, AFTER_EVICT).expect("send after evict");
+    harness.process_until(|h| h.raya().check(&convo_id, AFTER_EVICT));
+
+    assert!(
+        harness.raya().check(&convo_id, AFTER_EVICT),
+        "Raya must receive the sealed message to an UNCACHED convo via the route_index slow path"
+    );
+}
diff --git a/core/integration_tests_core/tests/test_graph_hiding_adversary.rs b/core/integration_tests_core/tests/test_graph_hiding_adversary.rs
new file mode 100644
index 0000000..a8a2c1d
--- /dev/null
+++ b/core/integration_tests_core/tests/test_graph_hiding_adversary.rs
@@ -0,0 +1,325 @@
+//! #graph-hiding Phase 1b — ADVERSARY test for the sealed-envelope / graph-hiding
+//! security property.
+//!
+//! Threat model: an honest-but-curious delivery node sees exactly what is published
+//! to the delivery layer — for every message, the `content_topic` (== the
+//! `delivery_address`) and the raw envelope `payload` bytes. It does NOT hold any
+//! client's MLS keys or seal keys. The claim under test is the NEGATIVE one:
+//! from (content_topic, payload) alone the node CANNOT recover the conversation
+//! graph.
+//!
+//! We drive real conversations through the in-process `LocalBroadcaster`, capture
+//! EVERY published `(content_topic, payload)` pair via `all_published()` (the exact
+//! node's-eye view — independent of any consumer's cursor/subscription/self-echo
+//! filter), decode each `EnvelopeV1` with `prost`, and assert the four properties
+//! plus a positive control proving the byte-search is not vacuous.
+//!
+//! What this DOES prove: the node cannot map wire traffic to real conversations
+//! from the topic, the conversation_hint, or the sealed payload contents.
+//! What this does NOT address: timing / traffic-analysis correlation, message-size
+//! side channels, or the invite/inbox rendezvous bootstrap path (which rides a
+//! per-recipient inbox topic, out of scope here — see the report notes).
+
+use chat_proto::logoschat::envelope::EnvelopeV1;
+use integration_tests_core::TestHarness;
+use prost::Message as _;
+use tracing::info;
+
+/// The single global content-topic every GroupV1/DirectV1 conversation shares.
+/// (Mirrors `GLOBAL_TOPIC` in core/conversations/src/conversation/group_v1.rs;
+/// the test asserts against the literal so a change to the constant is caught.)
+const GLOBAL_TOPIC: &str = "peers-global-v1";
+
+/// True iff `needle` occurs as a contiguous byte-subsequence of `haystack`.
+fn contains_bytes(haystack: &[u8], needle: &[u8]) -> bool {
+    if needle.is_empty() || needle.len() > haystack.len() {
+        return false;
+    }
+    haystack.windows(needle.len()).any(|w| w == needle)
+}
+
+/// Case-insensitive ASCII substring search (for the hex form of the group id).
+fn contains_ascii_ci(haystack: &[u8], needle: &str) -> bool {
+    let hay = haystack.to_ascii_lowercase();
+    let need = needle.to_ascii_lowercase().into_bytes();
+    contains_bytes(&hay, &need)
+}
+
+/// Assert the raw group id (both its raw bytes and its ASCII hex, case-insensitive)
+/// does NOT appear anywhere in `wire`.
+fn assert_group_id_absent(wire: &[u8], gid_raw: &[u8], gid_hex: &str, ctx: &str) {
+    assert!(
+        !contains_bytes(wire, gid_raw),
+        "LEAK: raw group_id bytes appear in published wire bytes ({ctx})"
+    );
+    assert!(
+        !contains_ascii_ci(wire, gid_hex),
+        "LEAK: group_id hex appears in published wire bytes ({ctx})"
+    );
+    // Also guard against the hex being carried uppercase.
+    assert!(
+        !contains_ascii_ci(wire, &gid_hex.to_ascii_uppercase()),
+        "LEAK: group_id hex (uppercase) appears in published wire bytes ({ctx})"
+    );
+}
+
+#[test]
+fn adversary_cannot_recover_conversation_graph() {
+    let _ = tracing_subscriber::fmt()
+        .with_max_level(tracing::Level::INFO)
+        .with_test_writer()
+        .try_init();
+
+    // ---- POSITIVE CONTROL (make the suite trustworthy) --------------------
+    // Prove the byte-search WOULD catch a leak, so an "absent" assertion later
+    // is not vacuous. We inject a known group-id into a synthetic envelope and
+    // confirm every search variant finds it.
+    {
+        let gid_raw: &[u8] = &[0xDE, 0xAD, 0xBE, 0xEF, 0x01, 0x02, 0x03, 0x04];
+        let gid_hex = hex::encode(gid_raw); // "deadbeef01020304"
+        let leaky = EnvelopeV1 {
+            conversation_hint: gid_hex.clone(), // a node that DID leak the id here
+            salt: 0,
+            payload: {
+                let mut p = b"prefix".to_vec();
+                p.extend_from_slice(gid_raw); // ...and in the (unsealed) payload
+                p.into()
+            },
+        };
+        let leaky_wire = leaky.encode_to_vec();
+        assert!(
+            contains_bytes(&leaky_wire, gid_raw),
+            "positive control: raw-byte search must find an embedded group_id"
+        );
+        assert!(
+            contains_ascii_ci(&leaky_wire, &gid_hex),
+            "positive control: hex search must find an embedded group_id hex"
+        );
+        assert!(
+            contains_ascii_ci(&leaky_wire, &gid_hex.to_ascii_uppercase()),
+            "positive control: hex search must be case-insensitive"
+        );
+        // And confirm the detector is not a constant-true: a random id it does
+        // NOT contain must NOT be found.
+        assert!(
+            !contains_bytes(&leaky_wire, &[0xAA; 16]),
+            "positive control: search must not report a false positive"
+        );
+        info!("positive control passed: byte-search detects an injected group_id");
+    }
+
+    // ---- Two distinct conversations for the SAME sending client -----------
+    let mut harness = TestHarness::<3>::new(|_, _| {});
+
+    let raya_addr = harness.raya().addr();
+    let pax_addr = harness.pax().addr();
+
+    // Convo A: a 1:1 (DirectV1) Saro <-> Raya.
+    let convo_a = harness
+        .saro()
+        .create_direct_convo_v1(&[&raya_addr])
+        .expect("saro create direct convo A");
+    harness.process_until_label("raya join A", |h| h.raya().convo_count() == 1);
+
+    // Convo B: a named group (GroupV1) Saro + Pax.
+    let convo_b = harness
+        .saro()
+        .create_group_convo_v1(&[&pax_addr], "grp", "desc")
+        .expect("saro create group convo B");
+    harness.process_until_label("pax join B", |h| h.pax().convo_count() == 1);
+
+    // convo_id == hex(mls_group.group_id()) — the value the node must NOT be able
+    // to recover from the wire. These are what a real test/app knows per convo.
+    assert_ne!(convo_a, convo_b, "the two conversations must have distinct ids");
+    let gid_a_raw = hex::decode(&convo_a).expect("convo_a is hex(group_id)");
+    let gid_b_raw = hex::decode(&convo_b).expect("convo_b is hex(group_id)");
+    assert_ne!(gid_a_raw, gid_b_raw, "the two group_ids must differ");
+
+    // Settle both convos with a warm-up so they are fully established, then verify
+    // real delivery works (this is a genuine, functioning graph — not a stub).
+    harness.saro().send_content(&convo_a, b"warm-a").expect("send warm A");
+    harness.saro().send_content(&convo_b, b"warm-b").expect("send warm B");
+    harness.process_until(|h| {
+        h.raya().check(&convo_a, b"warm-a") && h.pax().check(&convo_b, b"warm-b")
+    });
+
+    // ---- Capture the node's-eye view, isolating each convo's app message ----
+    // Snapshot the published-count, send ONE app message on A, then ONE on B, with
+    // no intervening processing, so the newly-appended global-topic envelopes are
+    // exactly Saro's two application messages — one per conversation. This lets us
+    // tie a captured hint to a known convo_id.
+    let base = harness.saro().ds().all_published().len();
+
+    harness.saro().send_content(&convo_a, b"secret-to-A").expect("send A");
+    let after_a = harness.saro().ds().all_published().len();
+
+    harness.saro().send_content(&convo_b, b"secret-to-B").expect("send B");
+    let all = harness.saro().ds().all_published();
+    let after_b = all.len();
+
+    // Exactly one new published envelope per send (send_content publishes one
+    // sealed app message; no commit/welcome on this path).
+    assert_eq!(after_a - base, 1, "one wire message for the A send");
+    assert_eq!(after_b - after_a, 1, "one wire message for the B send");
+
+    let (topic_a, wire_a) = all[base].clone();
+    let (topic_b, wire_b) = all[after_a].clone();
+    let env_a = EnvelopeV1::decode(wire_a.as_slice()).expect("decode envelope A");
+    let env_b = EnvelopeV1::decode(wire_b.as_slice()).expect("decode envelope B");
+    let hint_a = env_a.conversation_hint.clone();
+    let hint_b = env_b.conversation_hint.clone();
+
+    // ===================== PROPERTY 1: SINGLE TOPIC ========================
+    // Every conversation message rides the ONE global content-topic — there is no
+    // per-conversation topic selector. We check both isolated app messages AND the
+    // full population of conversation-layer messages (the commit published during
+    // group setup also rides the sealed global path).
+    assert_eq!(topic_a, GLOBAL_TOPIC, "A app message must ride the global topic");
+    assert_eq!(topic_b, GLOBAL_TOPIC, "B app message must ride the global topic");
+
+    // The legacy per-conversation delivery address (Blake2b6("delivery_addr|"||id))
+    // must NEVER appear as a topic — proving there is no per-convo topic selector.
+    for id in [&convo_a, &convo_b] {
+        let legacy = legacy_per_convo_topic(id);
+        assert!(
+            all.iter().all(|(t, _)| *t != legacy),
+            "a per-conversation topic ({legacy}) must never appear on the wire"
+        );
+        // Nor may the raw convo_id/group_id hex ever be used as a topic.
+        assert!(
+            all.iter().all(|(t, _)| t != id),
+            "the convo_id must never appear as a topic"
+        );
+    }
+
+    // Report the full set of topics seen (global conversation topic + any
+    // per-recipient inbox topics from the bootstrap/invite path).
+    let mut topics: Vec<String> = all.iter().map(|(t, _)| t.clone()).collect();
+    topics.sort();
+    topics.dedup();
+    info!(?topics, "all content-topics observed on the wire");
+    assert!(
+        topics.contains(&GLOBAL_TOPIC.to_string()),
+        "the global conversation topic must be present"
+    );
+
+    // ============ PROPERTY 2: NO CLEARTEXT CONVO ID IN THE HINT ============
+    assert_ne!(
+        hint_a, convo_a,
+        "conversation_hint (A) must NOT equal the convo_id (= hex group_id)"
+    );
+    assert_ne!(
+        hint_b, convo_b,
+        "conversation_hint (B) must NOT equal the convo_id (= hex group_id)"
+    );
+    // The hint must not even contain the group id as a substring.
+    assert!(
+        !contains_ascii_ci(hint_a.as_bytes(), &convo_a),
+        "conversation_hint (A) must not contain the group_id hex"
+    );
+    assert!(
+        !contains_ascii_ci(hint_b.as_bytes(), &convo_b),
+        "conversation_hint (B) must not contain the group_id hex"
+    );
+
+    // ============ PROPERTY 3: NO GROUP ID ANYWHERE ON THE WIRE =============
+    // Search EVERY published envelope's raw bytes for BOTH group_ids (raw + hex,
+    // case-insensitive). The MLS framing carries the group_id in cleartext; if the
+    // outer seal failed to hide it, it would surface here.
+    for (i, (topic, wire)) in all.iter().enumerate() {
+        assert_group_id_absent(wire, &gid_a_raw, &convo_a, &format!("msg#{i} topic={topic} vs A"));
+        assert_group_id_absent(wire, &gid_b_raw, &convo_b, &format!("msg#{i} topic={topic} vs B"));
+    }
+
+    // ================ PROPERTY 4: UNLINKABILITY ACROSS CONVOS ==============
+    // Distinct conversations from the SAME sender produce distinct opaque hints,
+    // and grouping the wire by (topic, hint) yields only opaque buckets that
+    // cannot be mapped to a real group_id (follows from #2 + #3).
+    assert_ne!(
+        hint_a, hint_b,
+        "two distinct conversations must publish distinct conversation_hints"
+    );
+
+    // A node bucketing all conversation-layer (global-topic) traffic by hint sees
+    // only opaque route-tags; none equals or contains either group_id.
+    let mut buckets: Vec<String> = all
+        .iter()
+        .filter(|(t, _)| t == GLOBAL_TOPIC)
+        .filter_map(|(_, w)| EnvelopeV1::decode(w.as_slice()).ok())
+        .map(|e| e.conversation_hint)
+        .collect();
+    buckets.sort();
+    buckets.dedup();
+    info!(bucket_count = buckets.len(), ?buckets, "opaque (topic,hint) buckets on global topic");
+    assert!(
+        buckets.len() >= 2,
+        "at least two opaque buckets expected (one per conversation)"
+    );
+    for b in &buckets {
+        assert_ne!(*b, convo_a, "no opaque bucket may equal a real group_id (A)");
+        assert_ne!(*b, convo_b, "no opaque bucket may equal a real group_id (B)");
+    }
+
+    // ---- Non-vacuity on REAL data: the search operates on live wire bytes ---
+    // The decoded hint we assert-absent-of-group-id IS itself present in the raw
+    // published envelope — proving Property 3's search runs over real content, not
+    // an empty buffer.
+    assert!(
+        contains_ascii_ci(&wire_a, &hint_a),
+        "sanity: the decoded hint must be found inside its own raw envelope"
+    );
+
+    // ---- Byte-level evidence for a human reviewer -------------------------
+    info!("================ BYTE-LEVEL EVIDENCE (convo A) ================");
+    info!(content_topic = %topic_a, "content_topic the node sees");
+    info!(convo_id = %convo_a, "convo_id (= hex group_id) the node must NOT recover");
+    info!(conversation_hint = %hint_a, "conversation_hint (opaque route_tag) on the wire");
+    info!(
+        payload_len = env_a.payload.len(),
+        payload_prefix = %hex::encode(&env_a.payload[..env_a.payload.len().min(24)]),
+        "sealed payload (ChaCha20-Poly1305: [12B nonce][ciphertext]) — pseudorandom"
+    );
+    info!(
+        group_id_raw_present = contains_bytes(&wire_a, &gid_a_raw),
+        group_id_hex_present = contains_ascii_ci(&wire_a, &convo_a),
+        "group_id absence in the full published envelope A"
+    );
+    info!("==============================================================");
+
+    println!("ADVERSARY EVIDENCE (convo A)");
+    println!("  content_topic       = {topic_a}");
+    println!("  convo_id (group_id) = {convo_a}");
+    println!("  conversation_hint   = {hint_a}");
+    println!("  hint == convo_id?     {}", hint_a == convo_a);
+    println!(
+        "  group_id raw in wire? {}",
+        contains_bytes(&wire_a, &gid_a_raw)
+    );
+    println!(
+        "  group_id hex in wire? {}",
+        contains_ascii_ci(&wire_a, &convo_a)
+    );
+    println!("  sealed payload len  = {}", env_a.payload.len());
+    println!(
+        "  sealed payload[..24]= {}",
+        hex::encode(&env_a.payload[..env_a.payload.len().min(24)])
+    );
+    println!("  --- convo B ---");
+    println!("  convo_id (group_id) = {convo_b}");
+    println!("  conversation_hint   = {hint_b}");
+    println!("  hint_a == hint_b?     {}", hint_a == hint_b);
+}
+
+/// Reproduces `GroupV1Convo::delivery_address_from_id` (the LEGACY per-conversation
+/// delivery address that Phase 1b replaced with the single global topic), so the
+/// test can assert it NEVER appears on the wire. Kept in sync by construction:
+/// Blake2b-48("delivery_addr|" || convo_id), hex-encoded.
+fn legacy_per_convo_topic(convo_id: &str) -> String {
+    use blake2::digest::consts::U6;
+    use blake2::{Blake2b, Digest};
+    let hash = Blake2b::<U6>::new()
+        .chain_update("delivery_addr|")
+        .chain_update(convo_id)
+        .finalize();
+    hex::encode(hash)
+}
diff --git a/core/integration_tests_core/tests/test_graph_hiding_bootstrap.rs b/core/integration_tests_core/tests/test_graph_hiding_bootstrap.rs
new file mode 100644
index 0000000..b89777d
--- /dev/null
+++ b/core/integration_tests_core/tests/test_graph_hiding_bootstrap.rs
@@ -0,0 +1,175 @@
+//! #graph-hiding Phase 1b — BOOTSTRAP / invite-path wire analysis.
+//!
+//! The adversary test covers steady-state application messages. This test extends the
+//! same honest-but-curious node model to the GROUP-CREATION + Welcome/invite flow, and
+//! makes two claims — one positive, one an HONEST disclosure of a residual leak:
+//!
+//!   POSITIVE: across the entire bootstrap (create group -> Welcome to Raya, add member
+//!   -> Welcome to Pax, plus the sealed commits on the global topic) the raw group_id
+//!   (bytes AND hex, case-insensitive) never appears anywhere on the wire. The MLS
+//!   Welcome encrypts its GroupInfo, so the group_id is not exposed even at join time.
+//!
+//!   RESIDUAL (disclosed, not hidden): the invite rides a per-recipient INBOX topic
+//!   `delivery_address_for(recipient)` and carries `conversation_hint =
+//!   conversation_id_for(recipient)` — BOTH deterministic functions of the RECIPIENT's
+//!   signer id alone. So a node CAN observe "someone is inviting <this recipient>"
+//!   (who-is-being-invited linkability), keyed to the recipient. It still cannot learn
+//!   WHICH group (group_id absent) nor WHO the inviter is (no sender field on the wire).
+//!   We assert this residual explicitly so the boundary is pinned by a test, not prose.
+
+use chat_proto::logoschat::envelope::EnvelopeV1;
+use integration_tests_core::TestHarness;
+use prost::Message as _;
+
+const GLOBAL_TOPIC: &str = "peers-global-v1";
+
+/// True iff `needle` occurs as a contiguous byte-subsequence of `haystack`.
+fn contains_bytes(haystack: &[u8], needle: &[u8]) -> bool {
+    if needle.is_empty() || needle.len() > haystack.len() {
+        return false;
+    }
+    haystack.windows(needle.len()).any(|w| w == needle)
+}
+
+/// Case-insensitive ASCII substring search (for the hex form of the group id).
+fn contains_ascii_ci(haystack: &[u8], needle: &str) -> bool {
+    let hay = haystack.to_ascii_lowercase();
+    let need = needle.to_ascii_lowercase().into_bytes();
+    contains_bytes(&hay, &need)
+}
+
+/// Reproduces `inbox_v2::delivery_address_for` (the per-recipient inbox topic):
+/// Blake2b-32 (U4) of "InboxV2|" || "delivery_address|" || recipient_id, hex-encoded.
+fn inbox_delivery_address(id: &str) -> String {
+    use blake2::digest::consts::U4;
+    use blake2::{Blake2b, Digest};
+    let h = Blake2b::<U4>::new()
+        .chain_update("InboxV2|")
+        .chain_update("delivery_address|")
+        .chain_update(id)
+        .finalize();
+    hex::encode(h)
+}
+
+/// Reproduces `inbox_v2::conversation_id_for` (the inbox-frame hint):
+/// Blake2b-48 (U6) of "InboxV2|" || "conversation_id|" || recipient_id, hex-encoded.
+fn inbox_conversation_id(id: &str) -> String {
+    use blake2::digest::consts::U6;
+    use blake2::{Blake2b, Digest};
+    let h = Blake2b::<U6>::new()
+        .chain_update("InboxV2|")
+        .chain_update("conversation_id|")
+        .chain_update(id)
+        .finalize();
+    hex::encode(h)
+}
+
+#[test]
+fn bootstrap_and_invite_path_do_not_leak_group_id() {
+    let _ = tracing_subscriber::fmt()
+        .with_max_level(tracing::Level::INFO)
+        .with_test_writer()
+        .try_init();
+
+    let mut harness = TestHarness::<3>::new(|_, _| {});
+    let raya_addr = harness.raya().addr();
+    let pax_addr = harness.pax().addr();
+
+    // Full bootstrap: create a named group (Welcome -> Raya), then add Pax
+    // (Welcome -> Pax). Both a create-time and an add-time invite are exercised.
+    let convo = harness
+        .saro()
+        .create_group_convo_v1(&[&raya_addr], "grp", "desc")
+        .expect("saro create group");
+    harness.process_until_label("raya join", |h| h.raya().convo_count() == 1);
+    harness
+        .saro()
+        .group_add_member(&convo, &[&pax_addr])
+        .expect("saro add pax");
+    harness.process_until_label("pax join", |h| h.pax().convo_count() == 1);
+
+    let gid_raw = hex::decode(&convo).expect("convo_id is hex(group_id)");
+
+    // Snapshot everything the node saw during bootstrap.
+    let all = harness.saro().ds().all_published();
+    assert!(!all.is_empty(), "bootstrap must have published wire traffic");
+
+    // ===================== POSITIVE: NO GROUP ID ON THE WIRE ===============
+    // Search EVERY published envelope — including the two Welcome/invite frames on
+    // the inbox topics — for the group_id (raw + hex, both cases).
+    for (i, (topic, wire)) in all.iter().enumerate() {
+        assert!(
+            !contains_bytes(wire, &gid_raw),
+            "LEAK: raw group_id bytes appear in bootstrap msg #{i} (topic={topic})"
+        );
+        assert!(
+            !contains_ascii_ci(wire, &convo),
+            "LEAK: group_id hex appears in bootstrap msg #{i} (topic={topic})"
+        );
+        assert!(
+            !contains_ascii_ci(wire, &convo.to_ascii_uppercase()),
+            "LEAK: group_id hex (uppercase) appears in bootstrap msg #{i} (topic={topic})"
+        );
+    }
+
+    // Enumerate the topics the node saw.
+    let mut topics: Vec<String> = all.iter().map(|(t, _)| t.clone()).collect();
+    topics.sort();
+    topics.dedup();
+
+    // The global conversation topic (sealed commits) must be present...
+    assert!(
+        topics.contains(&GLOBAL_TOPIC.to_string()),
+        "the global conversation topic must appear (sealed commits ride it)"
+    );
+
+    // ===================== RESIDUAL: PER-RECIPIENT INBOX TOPICS ============
+    // Both invitees' deterministic inbox topics MUST be present — this is the
+    // disclosed residual: the node sees a frame addressed to each recipient's inbox.
+    let raya_inbox = inbox_delivery_address(raya_addr.as_str());
+    let pax_inbox = inbox_delivery_address(pax_addr.as_str());
+    assert!(
+        topics.contains(&raya_inbox),
+        "Raya's create-time Welcome must ride her deterministic inbox topic ({raya_inbox})"
+    );
+    assert!(
+        topics.contains(&pax_inbox),
+        "Pax's add-time Welcome must ride his deterministic inbox topic ({pax_inbox})"
+    );
+
+    // The inbox topic is a pure function of the recipient's id — NOT of the group.
+    assert_ne!(raya_inbox, convo, "an inbox topic must not equal the group_id");
+    assert_ne!(pax_inbox, convo, "an inbox topic must not equal the group_id");
+
+    // Confirm the invite frame on Pax's inbox carries the recipient-derived hint,
+    // and that this hint is NOT the group_id (no group linkage from the hint).
+    let pax_invite = all
+        .iter()
+        .find(|(t, _)| *t == pax_inbox)
+        .map(|(_, w)| w.clone())
+        .expect("an invite frame on Pax's inbox topic");
+    let pax_hint = EnvelopeV1::decode(pax_invite.as_slice())
+        .expect("decode invite envelope")
+        .conversation_hint;
+    assert_eq!(
+        pax_hint,
+        inbox_conversation_id(pax_addr.as_str()),
+        "the invite frame's hint must be conversation_id_for(recipient) — recipient-derived"
+    );
+    assert_ne!(
+        pax_hint, convo,
+        "the invite hint must NOT be the group_id (no group linkage from the hint)"
+    );
+
+    // Honest boundary statement for a reviewer.
+    println!("BOOTSTRAP WIRE ANALYSIS");
+    println!("  group_id (never on wire)   = {convo}");
+    println!("  topics observed            = {topics:?}");
+    println!("  raya inbox topic (residual)= {raya_inbox}");
+    println!("  pax  inbox topic (residual)= {pax_inbox}");
+    println!("  pax invite hint (recip-derived, not group) = {pax_hint}");
+    println!(
+        "  RESIDUAL: node learns 'someone invited <recipient>' via the recipient's \
+         deterministic inbox topic/hint; it does NOT learn the group_id or the inviter."
+    );
+}
diff --git a/core/integration_tests_core/tests/test_graph_hiding_epoch_stability.rs b/core/integration_tests_core/tests/test_graph_hiding_epoch_stability.rs
new file mode 100644
index 0000000..dac77fd
--- /dev/null
+++ b/core/integration_tests_core/tests/test_graph_hiding_epoch_stability.rs
@@ -0,0 +1,130 @@
+//! #graph-hiding Phase 1b — EPOCH-STABILITY test (the highest-value one).
+//!
+//! This proves the property that the earlier per-epoch MLS-exporter approach FAILED:
+//! the on-wire `conversation_hint` (route_tag) must NOT change when the group's MLS
+//! epoch advances (a member is added/removed). Phase 1b derives the route_tag +
+//! outer_key from a random secret carried in a GroupContext extension — epoch-STABLE
+//! and identical for every member — instead of the per-epoch exporter. If routing
+//! depended on the epoch, a commit would silently re-tag the conversation and break
+//! delivery (exactly the wall that killed the exporter spikes).
+//!
+//! We: create a real named group, capture the route_tag of a message BEFORE an epoch
+//! change, force an epoch change by ADDING a member (a real MLS commit — verified via
+//! the `group_epoch_for_test` hook, which reads the live `MlsGroup::epoch()`), then
+//! send again and assert (a) the route_tag is unchanged and (b) delivery still works.
+
+use chat_proto::logoschat::envelope::EnvelopeV1;
+use integration_tests_core::{TestClient, TestHarness};
+use prost::Message as _;
+
+/// The single global content-topic every GroupV1/DirectV1 conversation shares.
+const GLOBAL_TOPIC: &str = "peers-global-v1";
+
+/// Send exactly one application message on `convo` and return the
+/// (content_topic, conversation_hint) the delivery node would observe for it. Relies
+/// on `send_content` publishing exactly one sealed envelope (no commit on this path).
+fn send_and_capture_hint(sender: &mut TestClient, convo: &str, body: &[u8]) -> (String, String) {
+    let base = sender.ds().all_published().len();
+    sender.send_content(convo, body).expect("send_content");
+    let all = sender.ds().all_published();
+    assert_eq!(
+        all.len() - base,
+        1,
+        "send_content must publish exactly one wire envelope"
+    );
+    let (topic, wire) = all[base].clone();
+    let hint = EnvelopeV1::decode(wire.as_slice())
+        .expect("decode EnvelopeV1")
+        .conversation_hint;
+    (topic, hint)
+}
+
+#[test]
+fn route_tag_is_stable_across_an_epoch_change() {
+    let _ = tracing_subscriber::fmt()
+        .with_max_level(tracing::Level::INFO)
+        .with_test_writer()
+        .try_init();
+
+    let mut harness = TestHarness::<3>::new(|_, _| {});
+    let raya_addr = harness.raya().addr();
+    let pax_addr = harness.pax().addr();
+
+    // Saro creates a real named group with Raya as the first member; settle join.
+    let convo = harness
+        .saro()
+        .create_group_convo_v1(&[&raya_addr], "grp", "desc")
+        .expect("saro create group");
+    harness.process_until_label("raya join", |h| h.raya().convo_count() == 1);
+
+    // Warm-up so the group is fully settled on both sides.
+    harness.saro().send_content(&convo, b"warm").expect("send warm");
+    harness.process_until(|h| h.raya().check(&convo, b"warm"));
+
+    let epoch_before = harness
+        .saro()
+        .group_epoch_for_test(&convo)
+        .expect("group cached on saro");
+
+    // ---- Capture the route_tag BEFORE the epoch change --------------------
+    let (topic_before, hint_before) =
+        send_and_capture_hint(harness.saro(), &convo, b"before-epoch");
+    assert_eq!(topic_before, GLOBAL_TOPIC, "pre-epoch send rides the global topic");
+    harness.process_until(|h| h.raya().check(&convo, b"before-epoch"));
+
+    // ---- Force an EPOCH CHANGE: add Pax (a real MLS Add commit) -----------
+    harness
+        .saro()
+        .group_add_member(&convo, &[&pax_addr])
+        .expect("saro add pax");
+    harness.process_until_label("pax join", |h| h.pax().convo_count() == 1);
+
+    let epoch_after = harness
+        .saro()
+        .group_epoch_for_test(&convo)
+        .expect("group cached on saro");
+    // PROVE the epoch actually advanced (this is a genuine epoch change, not a no-op).
+    assert!(
+        epoch_after > epoch_before,
+        "adding a member must advance the MLS epoch (before={epoch_before}, after={epoch_after})"
+    );
+
+    // ---- Capture the route_tag AFTER the epoch change ---------------------
+    let (topic_after, hint_after) = send_and_capture_hint(harness.saro(), &convo, b"after-epoch");
+    assert_eq!(topic_after, GLOBAL_TOPIC, "post-epoch send rides the global topic");
+
+    // ===================== PROPERTY (a): STABLE ROUTE_TAG ==================
+    // The conversation_hint is IDENTICAL across the epoch change. This is the exact
+    // property the per-epoch exporter approach could not guarantee.
+    assert_eq!(
+        hint_before, hint_after,
+        "route_tag/conversation_hint MUST be unchanged across an epoch change \
+         (before={hint_before}, after={hint_after})"
+    );
+
+    // ===================== PROPERTY (b): DELIVERY SURVIVES =================
+    // The post-epoch message must still reach BOTH the pre-existing member (Raya)
+    // and the newly-added member (Pax).
+    harness.process_until(|h| {
+        h.raya().check(&convo, b"after-epoch") && h.pax().check(&convo, b"after-epoch")
+    });
+    assert!(
+        harness.raya().check(&convo, b"after-epoch"),
+        "Raya (pre-existing member) must receive the post-epoch message"
+    );
+    assert!(
+        harness.pax().check(&convo, b"after-epoch"),
+        "Pax (added at the new epoch) must receive the post-epoch message"
+    );
+
+    // ---- Byte-level evidence for a human reviewer -------------------------
+    println!("EPOCH-STABILITY EVIDENCE");
+    println!("  mls_epoch before add = {epoch_before}");
+    println!(
+        "  mls_epoch after  add = {epoch_after}   (advanced: {})",
+        epoch_after > epoch_before
+    );
+    println!("  route_tag before     = {hint_before}");
+    println!("  route_tag after      = {hint_after}");
+    println!("  route_tag unchanged  = {}", hint_before == hint_after);
+}
diff --git a/core/integration_tests_core/tests/test_graph_hiding_late_joiner.rs b/core/integration_tests_core/tests/test_graph_hiding_late_joiner.rs
new file mode 100644
index 0000000..b95c14c
--- /dev/null
+++ b/core/integration_tests_core/tests/test_graph_hiding_late_joiner.rs
@@ -0,0 +1,102 @@
+//! #graph-hiding Phase 1b — LATE-JOINER / cross-member secret agreement.
+//!
+//! A member added to a group AFTER creation receives the epoch-stable graph secret
+//! inside the (encrypted) Welcome's GroupContext extension. This test proves the late
+//! joiner derives the SAME route_tag/outer_key as the creator — i.e. the sealed-
+//! envelope secret really does propagate through the Welcome — by:
+//!   (1) asserting the creator's and the late joiner's published `conversation_hint`
+//!       for the same group are byte-for-byte identical, and
+//!   (2) showing messages flow BOTH ways (creator->joiner and joiner->creator),
+//!       which can only happen if both sides share the same outer_key + route_tag.
+
+use chat_proto::logoschat::envelope::EnvelopeV1;
+use integration_tests_core::{TestClient, TestHarness};
+use prost::Message as _;
+
+const GLOBAL_TOPIC: &str = "peers-global-v1";
+
+/// Send exactly one application message and return (content_topic, conversation_hint).
+fn send_and_capture_hint(sender: &mut TestClient, convo: &str, body: &[u8]) -> (String, String) {
+    let base = sender.ds().all_published().len();
+    sender.send_content(convo, body).expect("send_content");
+    let all = sender.ds().all_published();
+    assert_eq!(all.len() - base, 1, "send_content must publish exactly one envelope");
+    let (topic, wire) = all[base].clone();
+    let hint = EnvelopeV1::decode(wire.as_slice())
+        .expect("decode EnvelopeV1")
+        .conversation_hint;
+    (topic, hint)
+}
+
+#[test]
+fn late_joiner_derives_same_route_tag_and_messages_flow_both_ways() {
+    let _ = tracing_subscriber::fmt()
+        .with_max_level(tracing::Level::INFO)
+        .with_test_writer()
+        .try_init();
+
+    let mut harness = TestHarness::<3>::new(|_, _| {});
+    let raya_addr = harness.raya().addr();
+    let pax_addr = harness.pax().addr();
+
+    // Saro creates a named group with Raya; settle Raya's join.
+    let convo = harness
+        .saro()
+        .create_group_convo_v1(&[&raya_addr], "grp", "desc")
+        .expect("saro create group");
+    harness.process_until_label("raya join", |h| h.raya().convo_count() == 1);
+
+    // Pax is added AFTER creation — the late joiner. It receives the graph secret
+    // via the Welcome's GroupContext extension.
+    harness
+        .saro()
+        .group_add_member(&convo, &[&pax_addr])
+        .expect("saro add pax (late joiner)");
+    harness.process_until_label("pax join", |h| h.pax().convo_count() == 1);
+
+    // ---- Creator's on-wire route_tag for this group -----------------------
+    let (topic_saro, hint_saro) = send_and_capture_hint(harness.saro(), &convo, b"from-saro");
+    assert_eq!(topic_saro, GLOBAL_TOPIC);
+    // Deliver Saro's message to both members (incl. the late joiner Pax).
+    harness.process_until(|h| {
+        h.raya().check(&convo, b"from-saro") && h.pax().check(&convo, b"from-saro")
+    });
+
+    // ---- Late joiner's on-wire route_tag for the SAME group ---------------
+    // (`all_published` reads the shared broadcast queue, so Pax's client sees the
+    // same global wire; capturing via Pax's handle is just for clarity.)
+    let (topic_pax, hint_pax) = send_and_capture_hint(harness.pax(), &convo, b"from-pax");
+    assert_eq!(topic_pax, GLOBAL_TOPIC);
+
+    // ===================== PROPERTY (1): SAME ROUTE_TAG ====================
+    // The late joiner derived the identical opaque route_tag from the secret it got
+    // in the Welcome — proving the GroupContext-extension secret propagated intact.
+    assert_eq!(
+        hint_saro, hint_pax,
+        "creator and late joiner must publish the SAME route_tag for the same group \
+         (saro={hint_saro}, pax={hint_pax})"
+    );
+
+    // ===================== PROPERTY (2): TWO-WAY DELIVERY ==================
+    // Pax's message reaches Saro and Raya; Saro's earlier message already reached Pax.
+    harness.process_until(|h| {
+        h.saro().check(&convo, b"from-pax") && h.raya().check(&convo, b"from-pax")
+    });
+    assert!(
+        harness.pax().check(&convo, b"from-saro"),
+        "late joiner Pax must RECEIVE the creator's message"
+    );
+    assert!(
+        harness.saro().check(&convo, b"from-pax"),
+        "creator Saro must RECEIVE the late joiner's message"
+    );
+    assert!(
+        harness.raya().check(&convo, b"from-pax"),
+        "original member Raya must RECEIVE the late joiner's message"
+    );
+
+    println!("LATE-JOINER SECRET-AGREEMENT EVIDENCE");
+    println!("  creator (saro) route_tag     = {hint_saro}");
+    println!("  late joiner (pax) route_tag  = {hint_pax}");
+    println!("  identical                    = {}", hint_saro == hint_pax);
+}
diff --git a/core/integration_tests_core/tests/test_graph_hiding_scale.rs b/core/integration_tests_core/tests/test_graph_hiding_scale.rs
new file mode 100644
index 0000000..68b689f
--- /dev/null
+++ b/core/integration_tests_core/tests/test_graph_hiding_scale.rs
@@ -0,0 +1,151 @@
+//! #graph-hiding Phase 1b — N-CONVERSATION unlinkability at scale.
+//!
+//! The adversary test proves pairwise unlinkability (2 convos). This strengthens it:
+//! ONE sending client runs N>=3 conversations (a mix of 1:1 and group). We assert the
+//! honest-but-curious node, bucketing all global-topic traffic by (topic, hint), sees
+//! EXACTLY N distinct opaque buckets — one per conversation — all on the single global
+//! topic, none of which maps to (equals or contains) any real group_id. So adding more
+//! conversations yields only more opaque, mutually-unlinkable route-tags.
+
+use chat_proto::logoschat::envelope::EnvelopeV1;
+use integration_tests_core::{TestClient, TestHarness};
+use prost::Message as _;
+use std::collections::BTreeSet;
+
+const GLOBAL_TOPIC: &str = "peers-global-v1";
+
+fn contains_bytes(haystack: &[u8], needle: &[u8]) -> bool {
+    if needle.is_empty() || needle.len() > haystack.len() {
+        return false;
+    }
+    haystack.windows(needle.len()).any(|w| w == needle)
+}
+
+fn contains_ascii_ci(haystack: &[u8], needle: &str) -> bool {
+    let hay = haystack.to_ascii_lowercase();
+    let need = needle.to_ascii_lowercase().into_bytes();
+    contains_bytes(&hay, &need)
+}
+
+/// Send exactly one application message and return (content_topic, conversation_hint).
+fn send_and_capture_hint(sender: &mut TestClient, convo: &str, body: &[u8]) -> (String, String) {
+    let base = sender.ds().all_published().len();
+    sender.send_content(convo, body).expect("send_content");
+    let all = sender.ds().all_published();
+    assert_eq!(all.len() - base, 1, "send_content must publish exactly one envelope");
+    let (topic, wire) = all[base].clone();
+    let hint = EnvelopeV1::decode(wire.as_slice())
+        .expect("decode EnvelopeV1")
+        .conversation_hint;
+    (topic, hint)
+}
+
+#[test]
+fn n_conversations_yield_n_unlinkable_opaque_buckets() {
+    let _ = tracing_subscriber::fmt()
+        .with_max_level(tracing::Level::INFO)
+        .with_test_writer()
+        .try_init();
+
+    let mut harness = TestHarness::<4>::new(|_, _| {});
+    let raya_addr = harness.raya().addr();
+    let pax_addr = harness.pax().addr();
+    let mira_addr = harness.mira().addr();
+
+    // N = 3 conversations for the SAME sender (Saro): two 1:1s + one named group.
+    let c1 = harness
+        .saro()
+        .create_direct_convo_v1(&[&raya_addr])
+        .expect("saro create direct with raya");
+    harness.process_until_label("raya join", |h| h.raya().convo_count() == 1);
+
+    let c2 = harness
+        .saro()
+        .create_direct_convo_v1(&[&pax_addr])
+        .expect("saro create direct with pax");
+    harness.process_until_label("pax join", |h| h.pax().convo_count() == 1);
+
+    let c3 = harness
+        .saro()
+        .create_group_convo_v1(&[&mira_addr], "grp", "desc")
+        .expect("saro create group with mira");
+    harness.process_until_label("mira join", |h| h.mira().convo_count() == 1);
+
+    let convos = [c1.clone(), c2.clone(), c3.clone()];
+    let distinct_ids: BTreeSet<&String> = convos.iter().collect();
+    assert_eq!(distinct_ids.len(), 3, "the three conversations must have distinct ids");
+
+    // ---- Send one app message on each, capturing its hint (back-to-back) ---
+    let (t1, hint1) = send_and_capture_hint(harness.saro(), &c1, b"m1");
+    let (t2, hint2) = send_and_capture_hint(harness.saro(), &c2, b"m2");
+    let (t3, hint3) = send_and_capture_hint(harness.saro(), &c3, b"m3");
+    for t in [&t1, &t2, &t3] {
+        assert_eq!(t, GLOBAL_TOPIC, "every conversation message rides the global topic");
+    }
+
+    // The three per-convo hints are distinct.
+    let hints: BTreeSet<String> = [hint1.clone(), hint2.clone(), hint3.clone()].into_iter().collect();
+    assert_eq!(hints.len(), 3, "the three conversations must publish three distinct hints");
+
+    // No hint equals or contains any group_id.
+    for hint in [&hint1, &hint2, &hint3] {
+        for c in &convos {
+            assert_ne!(hint, c, "a conversation_hint must never equal a group_id");
+            assert!(
+                !contains_ascii_ci(hint.as_bytes(), c),
+                "a conversation_hint must not contain a group_id hex"
+            );
+        }
+    }
+
+    // ===================== EXACTLY N OPAQUE BUCKETS =======================
+    // Bucket ALL global-topic traffic (the 3 setup commits + the 3 app sends) by
+    // hint. The node must see EXACTLY N=3 distinct opaque buckets — commit and app
+    // message for a convo share the one epoch-stable route_tag, so buckets == convos.
+    let all = harness.saro().ds().all_published();
+    let mut buckets: BTreeSet<String> = BTreeSet::new();
+    for (topic, wire) in all.iter().filter(|(t, _)| t == GLOBAL_TOPIC) {
+        let env = EnvelopeV1::decode(wire.as_slice()).expect("decode global-topic envelope");
+        // group_id (raw + hex) must be absent from every global-topic envelope.
+        for c in &convos {
+            let gid_raw = hex::decode(c).expect("convo_id is hex(group_id)");
+            assert!(
+                !contains_bytes(wire, &gid_raw),
+                "LEAK: raw group_id on the wire (topic={topic})"
+            );
+            assert!(
+                !contains_ascii_ci(wire, c),
+                "LEAK: group_id hex on the wire (topic={topic})"
+            );
+        }
+        buckets.insert(env.conversation_hint);
+    }
+    assert_eq!(
+        buckets.len(),
+        convos.len(),
+        "the node must see exactly N opaque (topic,hint) buckets on the global topic \
+         (N={}, observed={})",
+        convos.len(),
+        buckets.len()
+    );
+    // Every bucket is opaque: none equals a real group_id.
+    for b in &buckets {
+        for c in &convos {
+            assert_ne!(b, c, "no opaque bucket may equal a real group_id");
+        }
+    }
+    // The per-send hints are exactly the bucket set (sanity: buckets are the convos').
+    assert_eq!(buckets, hints, "the N buckets must be exactly the N per-convo route_tags");
+
+    // ---- The graph is genuine: every message actually delivers -----------
+    harness.process_until(|h| {
+        h.raya().check(&c1, b"m1") && h.pax().check(&c2, b"m2") && h.mira().check(&c3, b"m3")
+    });
+    assert!(harness.raya().check(&c1, b"m1"));
+    assert!(harness.pax().check(&c2, b"m2"));
+    assert!(harness.mira().check(&c3, b"m3"));
+
+    println!("N-CONVERSATION UNLINKABILITY EVIDENCE (N={})", convos.len());
+    println!("  global-topic opaque buckets = {buckets:?}");
+    println!("  group_ids (never in buckets) = {convos:?}");
+}
