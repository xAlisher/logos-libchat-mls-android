+/// Generate a fresh persistent identity: `(account_seed, delegate_seed)`, two
+/// 32-byte Ed25519 seeds. Persist them (encrypted) and pass them to
+/// [`open_persistent`] on every launch to keep a **stable address across
+/// restarts** — the account address is `hex(verifying_key(account_seed))`, fixed
+/// by the seed. This is the persistent-identity path the ephemeral [`open`]
+/// (fresh account every call) does not provide.
+pub fn generate_identity() -> ([u8; 32], [u8; 32]) {
+    (
+        Ed25519SigningKey::generate().to_bytes(),
+        Ed25519SigningKey::generate().to_bytes(),
+    )
+}
+
+/// Open a Logos client with a **persisted identity**: `account_seed` and
+/// `delegate_seed` (from [`generate_identity`], stored between runs) rehydrate
+/// the account + delegate, so the client keeps the SAME address across restarts.
+///
+/// Mirrors [`open`] otherwise — starts the embedded delivery node, (idempotently)
+/// republishes the delegate to the registry, and opens encrypted storage — but
+/// replaces the throwaway `TestLogosAccount::new()` / `DelegateSigner::random()`
+/// with keys reconstructed from the supplied seeds. This is the load-or-create
+/// substrate the desktop module relies on; the caller owns seed storage
+/// (Android Keystore-encrypted on device).
+pub fn open_persistent(
+    config: LogosConfig,
+    account_seed: [u8; 32],
+    delegate_seed: [u8; 32],
+) -> Result<(LogosChatClient, Receiver<Event>), ClientError> {
+    let transport = EmbeddedLogosDelivery::start(config.p2p_config.clone())
+        .map_err(|e| ClientError::Transport(e.to_string()))?;
+    let account = TestLogosAccount::from_signing_key(Ed25519SigningKey::from_bytes(&account_seed));
+    let delegate = DelegateSigner::from_signing_key(Ed25519SigningKey::from_bytes(&delegate_seed));
+    let mut registry = HttpRegistry::new(config.registry_url);
+    account
+        .add_delegate_signer(&mut registry, delegate.public_key())
+        .map_err(|e| ClientError::BundlePublish(e.to_string()))?;
+    let mut builder = ChatClientBuilder::new(account.address())
+        .ident(delegate)
+        .transport(transport)
+        .registration(registry)
+        .storage_config(StorageConfig::Encrypted {
+            path: config.db_path,
+            key: config.db_key,
+        });
+    if let Some(group_v2) = config.group_v2_config {
+        builder = builder.group_v2_config(group_v2);
+    }
+    builder.build()
+}
+
