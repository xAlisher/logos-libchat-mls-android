+    /// reload it, and recover the same key (hence the same address) across
+    /// restarts.
+    pub fn from_bytes(bytes: &[u8; 32]) -> Self {
+        Self(ed25519_dalek::SigningKey::from_bytes(bytes))
+    }
+
+    /// The 32-byte seed of this signing key, for persistence. Secret material —
+    /// store encrypted (e.g. Android Keystore).
+    pub fn to_bytes(&self) -> [u8; 32] {
+        self.0.to_bytes()
+    }
