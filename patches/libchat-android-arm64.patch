+    // #235: encrypt on one client and hand the raw bytes to the other via
+    // `ingest_ciphertext` — NOT through the transport bus — to prove the off-node
+    // (e.g. BLE) delivery path works end to end. Establishment still goes over the
+    // bus (the welcome); only the message rides the off-node path.
+    let bus = MessageBus::default();
+    let reg_service = EphemeralRegistry::new();
+
+    let (mut saro, _saro_events) =
+        create_test_client(bus.clone(), reg_service.clone()).expect("client create");
+    let (raya, raya_events) =
+        create_test_client(bus.clone(), reg_service.clone()).expect("client create");
+
+    let convo_id = saro.create_direct_conversation(raya.addr()).unwrap();
+    expect_event(&raya_events, "ConversationStarted", |e| match e {
+        Event::ConversationStarted { convo_id, .. } => Ok(convo_id),
+        other => Err(other),
+    });
+
+    // Encrypt WITHOUT publishing — produces no bus traffic.
+    let env: AddressedEnvelope = saro
+        .encrypt_for_convo(&convo_id, b"off-node hello")
+        .expect("encrypt_for_convo");
+    assert!(!env.data.is_empty(), "envelope carried no bytes");
+    assert!(!env.delivery_address.is_empty(), "no delivery address");
+
+    // Deliver the ciphertext out-of-band (the BLE mesh in production).
+    raya.ingest_ciphertext(env.data).expect("ingest_ciphertext");
+
+    expect_event(&raya_events, "MessageReceived (off-node)", |e| match e {
+        Event::MessageReceived { content, .. } => {
+            assert_eq!(content.as_slice(), b"off-node hello");
+            Ok(())
+        }
+        other => Err(other),
+    });
+}
