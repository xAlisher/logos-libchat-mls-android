+    /// #349: remove other members from a group (creator-gated at the app layer).
+    /// Like group_add_member, checkpoints even on failure — a partially applied
+    /// remove still mutated MLS state and must not be lost.
+    pub fn group_remove_member(
+        &mut self,
+        convo_id: &str,
+        members: &[IdentIdRef],
+    ) -> Result<(), ChatError> {
+        let result = self.group_remove_member_inner(convo_id, members);
+        self.persist_mls_state()?;
+        result
+    }
+
+    fn group_remove_member_inner(
+        &mut self,
+        convo_id: &str,
+        members: &[IdentIdRef],
+    ) -> Result<(), ChatError> {
+        if self.cached_convos.contains_key(convo_id) {
+            let convo = self
+                .cached_convos
+                .get_mut(convo_id)
+                .ok_or_else(|| ChatError::NoConvo(convo_id.to_string()))?;
+
+            match convo {
+                ConvoTypeOwned::Group(group_convo) => {
+                    group_convo.remove_member(&mut self.services, members)
+                }
+                ConvoTypeOwned::Direct(convo) => Err(ChatError::UnsupportedFunction(
+                    convo.id().into(),
+                    "Remove Member".into(),
+                )),
+            }
+        } else {
+            let mut convo = self.load_group_convo(convo_id)?;
+            convo.remove_member(&mut self.services, members)
+        }
+    }
