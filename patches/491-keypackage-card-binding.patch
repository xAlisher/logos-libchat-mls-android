+/// #GHSA-xxgx-7757-3qq6 Layer 1b: verify a key-package publication binds to
+/// `device_id` before it is cached for an offline add. The device must be one the
+/// account endorses, and the publication must carry that device's signature over
+/// its payload (proof-of-possession) — exactly the authenticated network
+/// `retrieve` branch, which the #239 local cache skipped. Returns the raw key
+/// package on success. Case-insensitive on `device_id` (signed ids are lower-case
+/// hex; the card string is untrusted).
+pub(crate) fn verify_keypackage_publication(
+    set: &DeviceSet,
+    device_id: &str,
+    kp_payload: &[u8],
+    kp_sig: &[u8],
+) -> Result<Vec<u8>, String> {
+    if !set
+        .devices
+        .iter()
+        .any(|d| d.eq_ignore_ascii_case(device_id))
+    {
+        return Err(format!("device {device_id} not in account's device set"));
+    }
+    let dev_bytes: [u8; 32] = hex::decode(device_id)
+        .map_err(|e| e.to_string())?
+        .try_into()
+        .map_err(|_| "device_id not a 32-byte key".to_string())?;
+    let dev_key = Ed25519VerifyingKey::from_bytes(&dev_bytes)
+        .map_err(|_| "device_id not a valid ed25519 key".to_string())?;
+    let sig_arr: [u8; 64] = kp_sig
+        .try_into()
+        .map_err(|_| "kp signature not 64 bytes".to_string())?;
+    dev_key
+        .verify(kp_payload, &Ed25519Signature::from(sig_arr))
+        .map_err(|_| "key package signature invalid".to_string())?;
+    let (_ts, key_package) =
+        decode_payload(kp_payload).ok_or_else(|| "short kp payload".to_string())?;
+    Ok(key_package.to_vec())
+}
