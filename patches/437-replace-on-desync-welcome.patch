+    /// #437: overwrite an already-cached convo with a freshly-adopted one — the
+    /// #350 desync re-add resync path. Unlike `register_convo` this EXPECTS the id
+    /// to already exist (the stale, epoch-desynced copy) and replaces it in place,
+    /// refreshing the route_index too. Used only for a re-add welcome the native
+    /// layer accepted at a strictly-newer epoch, so it never masks the accidental
+    /// duplicate that `register_convo` guards against on the create paths.
+    fn replace_convo(&mut self, convo: ConvoTypeOwned<S>) {
+        let id = convo.id().to_string();
+        let tag = match &convo {
+            ConvoTypeOwned::Group(c) => c.route_tag(),
+            ConvoTypeOwned::Direct(c) => c.route_tag(),
+        };
+        if let Some(tag) = tag {
+            self.route_index.insert(tag, id.clone());
+        }
+        self.cached_convos.insert(id, convo);
+    }
