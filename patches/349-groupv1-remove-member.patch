+    }
+
+    // Omitting the field entirely when empty keeps the encoding byte-identical to
+    // pre-#349, so GroupV2 metadata and 1-1 blobs are untouched.
+    #[test]
+    fn empty_creator_is_not_written() {
+        let with_empty =
+            ConvoMetaInfo::new_with_creator("group", "desc", Vec::new()).to_extension_bytes();
+        assert_eq!(
+            with_empty,
+            ConvoMetaInfo::new("group", "desc").to_extension_bytes()
+        );
+    }
+
+    // A pre-#349 decoder reads version/name/desc positionally and stops; the creator
+    // bytes are trailing, so a new blob must still yield the right name/desc when only
+    // that prefix is consumed. Simulated by decoding the new blob truncated to the
+    // legacy length.
+    #[test]
+    fn old_decoder_prefix_still_yields_name_and_desc() {
+        let legacy_len = ConvoMetaInfo::new("group", "desc")
+            .to_extension_bytes()
+            .len();
+        let new = ConvoMetaInfo::new_with_creator("group", "desc", CREATOR).to_extension_bytes();
+        assert!(new.len() > legacy_len, "creator is appended, not inlined");
+        assert_eq!(&new[..legacy_len], &ConvoMetaInfo::new("group", "desc").to_extension_bytes()[..]);
+        let prefix = ConvoMetaInfo::from_extension_bytes(&new[..legacy_len]).expect("decodes");
+        assert_eq!((prefix.name.as_str(), prefix.desc.as_str()), ("group", "desc"));
+    }
+}
