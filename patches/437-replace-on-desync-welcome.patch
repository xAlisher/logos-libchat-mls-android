+/// #349/#437: the group creator's leaf-credential content, read from a group's
+/// authenticated group-context metadata extension (`ConvoMetaInfo::creator`).
+/// `None` for a 1-1 delegate (no metadata) or a pre-#349 group (no recorded
+/// creator). Authenticated: GroupContext extensions are covered by the
+/// confirmation tag and identical for every member, so a peer cannot forge this.
+/// Free function so both #349's removal gate and #437's replace-on-desync author
+/// check can read it from any loaded `MlsGroup` (not just a live `GroupV1Convo`).
+fn creator_credential_of(group: &MlsGroup) -> Option<Vec<u8>> {
+    group
+        .extensions()
+        .iter()
+        .find_map(|ext| {
+            if let Extension::Unknown(ext_type, UnknownExtension(bytes)) = ext
+                && *ext_type == GROUP_METADATA_EXTENSION_TYPE
+            {
+                return ConvoMetaInfo::from_extension_bytes(bytes).ok();
+            }
+            None
+        })
+        .map(|meta| meta.creator().to_vec())
+        .filter(|creator| !creator.is_empty())
+}
