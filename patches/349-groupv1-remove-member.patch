+    // #349: remove one or more members by signer id. Symmetric to add_member,
+    // but produces an MLS RemoveProposal+Commit (no Welcome) that advances the
+    // epoch and ejects the targets; every remaining member applies the commit
+    // and the removed leaf can no longer decrypt. A member's leaf credential
+    // content IS its signer id bytes (BasicCredential::new(id.as_str().as_bytes),
+    // see inbox_v2::identity), so we resolve leaves by matching that content.
+    fn remove_member(
+        &mut self,
+        cx: &mut ServiceContext<S>,
+        members: &[IdentIdRef],
+    ) -> Result<(), ChatError> {
+        if members.is_empty() {
+            return Ok(());
+        }
+
+        // Resolve each target signer id to its live MLS leaf index.
+        let targets: Vec<&[u8]> = members.iter().map(|m| m.as_str().as_bytes()).collect();
+        let leaves: Vec<LeafNodeIndex> = self
+            .mls_group
+            .members()
+            .filter(|m| targets.contains(&m.credential.serialized_content()))
+            .map(|m| m.index)
+            .collect();
+        if leaves.is_empty() {
+            return Err(ChatError::Protocol(
+                "remove_member: no matching group member for the given signer id(s)".into(),
+            ));
+        }
+
+        // NB: never `.unwrap()` an MLS op on a worker thread — surface the error.
+        let (commit, _welcome, _group_info) = self
+            .mls_group
+            .remove_members(&cx.mls_provider, &cx.mls_identity, &leaves)
+            .map_err(ChatError::generic)?;
+
+        self.mls_group
+            .merge_pending_commit(&cx.mls_provider)
+            .map_err(ChatError::generic)?;
+
+        self.send_payload(cx, commit.to_bytes()?)
+    }
