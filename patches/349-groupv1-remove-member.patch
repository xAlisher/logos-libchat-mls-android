+/// #349 security: is a received Commit allowed to apply its Remove proposals?
+///
+/// MLS gives Remove no authorization semantics of its own, so the policy lives here
+/// and is decided from authenticated group state only:
+///
+/// * `creator` — the creator's leaf-credential content from the group-context metadata
+///   extension. `None` means the group predates #349 (or is a 1-1 delegate): nothing
+///   in group state says who may remove, so **nobody** may — fail closed. Such groups
+///   never had a removal capability, so this takes nothing away.
+/// * `committer` — the leaf credential of whoever signed this Commit (MLS-authenticated).
+/// * `removals` — `(removed, proposer)` credential pairs, one per Remove proposal.
+///
+/// A commit with no Remove proposals is unaffected (adds, updates, self-updates).
+/// A member proposing its OWN removal is a leave, not an eviction, and stays allowed
+/// whoever commits it — otherwise adding GroupV1 leave (#108) would deadlock.
+fn removes_authorized(
+    creator: Option<&[u8]>,
+    committer: &[u8],
+    removals: &[(Option<Vec<u8>>, Option<Vec<u8>>)],
+) -> bool {
+    if removals.is_empty() {
+        return true;
+    }
+    let Some(creator) = creator else {
+        return false;
+    };
+    if committer == creator {
+        return true;
+    }
+    removals
+        .iter()
+        .all(|(removed, proposer)| match (removed, proposer) {
+            (Some(removed), Some(proposer)) => removed == proposer,
+            _ => false,
+        })
+}
