+impl MlsStateStore for ChatStorage {
+    /// Saves the MLS provider's serialized state as the single `mls_state` row.
+    ///
+    /// The blob carries MLS private key material, so it lives in this database
+    /// (encrypted under `StorageConfig::Encrypted`) exactly like the identity's
+    /// secret key does — never in a plaintext sidecar.
+    fn save_mls_state(&mut self, blob: &[u8]) -> Result<(), StorageError> {
+        self.db
+            .connection()
+            .execute(
+                "INSERT INTO mls_state (id, state, updated_at)
+                 VALUES (1, ?1, strftime('%s', 'now'))
+                 ON CONFLICT(id) DO UPDATE SET
+                     state = excluded.state,
+                     updated_at = excluded.updated_at",
+                params![blob],
+            )
+            .map_err(map_rusqlite_error)?;
+        Ok(())
+    }
+
+    /// Loads the MLS provider's serialized state, if one was ever saved.
+    fn load_mls_state(&self) -> Result<Option<Vec<u8>>, StorageError> {
+        let mut stmt = self
+            .db
+            .connection()
+            .prepare("SELECT state FROM mls_state WHERE id = 1")
+            .map_err(map_rusqlite_error)?;
+
+        let result = stmt.query_row([], |row| row.get::<_, Vec<u8>>(0));
+        map_optional_row(result)
+    }
+}
