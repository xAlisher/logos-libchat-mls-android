+    /// Create (or restore) an SDS reliable channel. Returns the channel id.
+    ///
+    /// `sender_id` must be non-empty — an empty id disables the node's SDS repair
+    /// participation upstream. Uses the same one-shot heap-boxed callback pattern
+    /// as [`Self::subscribe`]; `createReliableChannel` resolves synchronously
+    /// upstream but the trampoline path handles both sync and async completion.
+    pub fn channel_create(
+        &self,
+        channel_id: &str,
+        content_topic: &str,
+        sender_id: &str,
+    ) -> Result<String, String> {
+        let channel_cstr = CString::new(channel_id).map_err(|e| e.to_string())?;
+        let topic_cstr = CString::new(content_topic).map_err(|e| e.to_string())?;
+        let sender_cstr = CString::new(sender_id).map_err(|e| e.to_string())?;
+
+        let (tx, rx) = mpsc::sync_channel::<Result<String, String>>(1);
+        let closure = move |ret: i32, data: &str| {
+            let _ = tx.send(if ret == RET_OK {
+                Ok(data.to_string())
+            } else {
+                Err(data.to_string())
+            });
+        };
+        let raw = Box::into_raw(Box::new(closure));
+        let cb = get_trampoline(unsafe { &*raw });
+
+        let ret = unsafe {
+            ffi::logosdelivery_channel_create(
+                self.ctx,
+                cb,
+                raw as *const c_void,
+                channel_cstr.as_ptr(),
+                topic_cstr.as_ptr(),
+                sender_cstr.as_ptr(),
+            )
+        };
+
+        if ret != RET_OK {
+            drop(unsafe { Box::from_raw(raw) });
+            return Err(format!("logosdelivery_channel_create returned {ret}"));
+        }
+        let result = rx
+            .recv()
+            .unwrap_or(Err("callback channel disconnected".into()));
+        drop(unsafe { Box::from_raw(raw) });
+        result
+    }
+
