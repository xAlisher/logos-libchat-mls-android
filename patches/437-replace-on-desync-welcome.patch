+#[cfg(test)]
+mod replace_auth_tests {
+    use super::replace_authorized;
+
+    // The recorded creator anchor is a signer id = hex(Ed25519 verifying key); the author
+    // passed to the gate is the welcome sender's RAW signature_key bytes.
+    const CREATOR_KEY: &[u8] = &[0xAAu8; 32];
+    const MALLORY_KEY: &[u8] = &[0xBBu8; 32];
+
+    fn creator_id(key: &[u8]) -> Vec<u8> {
+        hex::encode(key).into_bytes()
+    }
+
+    // Legitimate #350 recovery: the creator's own re-add welcome — signed with the
+    // creator's key — may replace our stale/desynced state so we rejoin.
+    #[test]
+    fn creator_key_authors_replace() {
+        assert!(
+            replace_authorized(Some(&creator_id(CREATOR_KEY)), CREATOR_KEY),
+            "a welcome signed with the recorded creator key must be allowed to replace"
+        );
+    }
+
+    // The review's hijack: adds are not creator-gated, so a non-creator can fork the group
+    // and ship a valid higher-epoch welcome — but it is signed with THEIR key, which does
+    // not match the recorded creator key, so it must be refused. This also defeats
+    // credential-byte spoofing: copying the creator's id into a credential doesn't help,
+    // the gate only trusts the authenticated signing key.
+    #[test]
+    fn non_creator_key_cannot_replace() {
+        assert!(
+            !replace_authorized(Some(&creator_id(CREATOR_KEY)), MALLORY_KEY),
+            "a welcome signed with a non-creator key must never replace our group (#437)"
+        );
+    }
+
+    // Fail closed with no recorded creator (pre-#349 group / 1-1 delegate).
+    #[test]
+    fn absent_creator_never_replaces() {
+        assert!(!replace_authorized(None, CREATOR_KEY));
+        assert!(!replace_authorized(None, MALLORY_KEY));
+    }
+
+    // A malformed / non-hex / empty creator id fails closed rather than matching anything.
+    #[test]
+    fn malformed_creator_id_fails_closed() {
+        assert!(!replace_authorized(Some(b"not-hex-zzzz"), CREATOR_KEY));
+        assert!(!replace_authorized(Some(b""), &[]));
+    }
+
+    // Exact key match — a truncated creator key is not the creator.
+    #[test]
+    fn key_match_is_exact() {
+        assert!(!replace_authorized(
+            Some(&creator_id(CREATOR_KEY)),
+            &CREATOR_KEY[..CREATOR_KEY.len() - 1]
+        ));
+    }
+}
