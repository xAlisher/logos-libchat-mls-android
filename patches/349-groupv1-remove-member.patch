+// #349 security — the removal-authorization gate that runs on RECEIPT.
+//
+// This is the property the whole feature rests on: MLS has no authorization for
+// Remove, so if these tests go green-to-red, any group member can evict any other
+// member and every honest client will apply it. The gate is a pure function of
+// authenticated group state (the creator recorded in the group context, the
+// MLS-authenticated committer credential, and the staged Remove proposals), so it
+// is testable without a live MLS group.
+#[cfg(test)]
+mod remove_auth_tests {
+    use super::removes_authorized;
+
+    const CREATOR: &[u8] = b"creator-leaf-credential";
+    const MALLORY: &[u8] = b"mallory-leaf-credential";
+    const VICTIM: &[u8] = b"victim-leaf-credential";
+
+    fn pair(removed: &[u8], proposer: &[u8]) -> (Option<Vec<u8>>, Option<Vec<u8>>) {
+        (Some(removed.to_vec()), Some(proposer.to_vec()))
+    }
+
+    // The attack from the review: a non-creator member commits a Remove for someone
+    // else. Must NOT be applied.
+    #[test]
+    fn non_creator_cannot_evict_another_member() {
+        assert!(
+            !removes_authorized(Some(CREATOR), MALLORY, &[pair(VICTIM, MALLORY)]),
+            "a non-creator's eviction of another member must be rejected on receipt"
+        );
+    }
+
+    // ...including when it is the CREATOR being evicted (group takeover).
+    #[test]
+    fn non_creator_cannot_evict_the_creator() {
+        assert!(
+            !removes_authorized(Some(CREATOR), MALLORY, &[pair(CREATOR, MALLORY)]),
+            "a member must not be able to evict the group creator"
+        );
+    }
+
+    // The legitimate path stays open.
+    #[test]
+    fn creator_may_evict() {
+        assert!(
+            removes_authorized(Some(CREATOR), CREATOR, &[pair(VICTIM, CREATOR)]),
+            "the recorded creator must still be able to remove a member"
+        );
+    }
+
+    // Fail closed on a group whose context records no creator (pre-#349 groups and
+    // the 1-1 delegate): nothing in authenticated state says who may remove, so nobody may.
+    #[test]
+    fn absent_creator_authorizes_nobody() {
+        assert!(
+            !removes_authorized(None, CREATOR, &[pair(VICTIM, CREATOR)]),
+            "with no creator in group state the gate must fail closed"
+        );
+        assert!(!removes_authorized(None, MALLORY, &[pair(VICTIM, MALLORY)]));
+    }
+
+    // Commits with no Remove proposals (adds, updates, key rotations) are untouched —
+    // the gate must not break ordinary group traffic, incl. on pre-#349 groups.
+    #[test]
+    fn commits_without_removes_are_unaffected() {
+        assert!(removes_authorized(Some(CREATOR), MALLORY, &[]));
+        assert!(removes_authorized(None, MALLORY, &[]));
+    }
+
+    // A member proposing its own removal is a leave (#108), allowed whoever commits it.
+    #[test]
+    fn self_removal_is_a_leave_and_stays_allowed() {
+        assert!(
+            removes_authorized(Some(CREATOR), MALLORY, &[pair(VICTIM, VICTIM)]),
+            "a member's own leave proposal must still be committable by anyone"
+        );
+    }
+
+    // ...but a non-creator must not smuggle an eviction alongside a genuine leave.
+    #[test]
+    fn a_leave_does_not_launder_an_eviction_in_the_same_commit() {
+        assert!(
+            !removes_authorized(
+                Some(CREATOR),
+                MALLORY,
+                &[pair(VICTIM, VICTIM), pair(CREATOR, MALLORY)]
+            ),
+            "every Remove in the commit must be authorized, not just the first"
+        );
+    }
+
+    // An unresolvable removed/proposer leaf (blank leaf, external sender — neither can
+    // legitimately drive a Remove) is never treated as a self-leave.
+    #[test]
+    fn unresolvable_leaves_are_not_self_removals() {
+        assert!(!removes_authorized(
+            Some(CREATOR),
+            MALLORY,
+            &[(Some(VICTIM.to_vec()), None)]
+        ));
+        assert!(!removes_authorized(
+            Some(CREATOR),
+            MALLORY,
+            &[(None, Some(MALLORY.to_vec()))]
+        ));
+        assert!(!removes_authorized(Some(CREATOR), MALLORY, &[(None, None)]));
+    }
+
+    // The comparison is exact bytes — a prefix of the creator credential is not the
+    // creator (guards against a truncating/`starts_with` regression).
+    #[test]
+    fn committer_match_is_exact() {
+        assert!(!removes_authorized(
+            Some(CREATOR),
+            &CREATOR[..CREATOR.len() - 1],
+            &[pair(VICTIM, CREATOR)]
+        ));
+        assert!(!removes_authorized(
+            Some(CREATOR),
+            b"creator-leaf-credential-x",
+            &[pair(VICTIM, CREATOR)]
+        ));
+    }
+}
