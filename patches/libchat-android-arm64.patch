+                    let due = last_catchup.get(t).map_or(true, |&last| {
+                        now.saturating_sub(last) >= CATCHUP_MIN_INTERVAL_NS
+                    });
+                    if due {
+                        Some((t.clone(), Self::catchup_start_ns(last_catchup.get(t).copied(), now)))
+                    } else {
+                        None
+                    }
+                }
+                _ => None,
+            };
+            let result = if use_channels {
+                // ── SDS reliable-channel path (channelId == content_topic) ──
+                //
+                // A reliable channel does NOT subscribe to Waku itself — its
+                // ingress listener filters the node's existing
+                // `MessageReceivedEvent` broker stream by content topic. So the
+                // node must ALSO hold a plain messaging subscription for the
+                // topic, or nothing ever reaches the channel. `ensure` wires
+                // both: the Waku subscription (feeds the broker) + the SDS
+                // channel (unwraps/repairs). Idempotent.
+                //
+                // `strict_sub` surfaces a subscribe failure on the explicit
+                // Subscribe op but tolerates it on the publish path (a repeat
+                // subscribe may already be active).
+                let ensure = |topic: &str, strict_sub: bool| -> Result<(), String> {
+                    if let Err(e) = node.subscribe(topic) {
+                        if strict_sub {
+                            return Err(e);
+                        }
+                    }
+                    node.channel_create(topic, topic, &sender_id)
+                        .map(|_| ())
+                        .or_else(|e| {
+                            if e.contains("already exists") {
+                                Ok(())
+                            } else {
+                                Err(e)
+                            }
+                        })
+                };
+                match cmd.op {
+                    NodeOp::Subscribe(topic) => {
+                        ensure(&topic, true).map_err(DeliveryError::SubscribeFailed)
+                    }
+                    NodeOp::Unsubscribe(topic) => {
+                        let _ = node.channel_close(&topic);
+                        node.unsubscribe(&topic)
+                            .map_err(DeliveryError::UnsubscribeFailed)
+                    }
+                    NodeOp::Publish {
+                        content_topic,
+                        payload,
+                    } => match ensure(&content_topic, false) {
+                        Ok(()) => {
+                            let msg = ChannelMessage {
+                                payload: BASE64.encode(&payload),
+                                ephemeral: false,
+                            };
+                            match serde_json::to_string(&msg) {
+                                Ok(json) => node
+                                    .channel_send(&content_topic, &json)
+                                    .map(|_| ())
+                                    .map_err(DeliveryError::PublishFailed),
+                                Err(e) => Err(DeliveryError::PublishFailed(e.to_string())),
+                            }
+                        }
+                        Err(e) => Err(DeliveryError::PublishFailed(e)),
+                    },
+                }
+            } else {
+                // ── Plain relay/filter path (no backfill) ──
+                match cmd.op {
+                    NodeOp::Subscribe(topic) => node
+                        .subscribe(&topic)
+                        .map_err(DeliveryError::SubscribeFailed),
+                    NodeOp::Unsubscribe(topic) => node
+                        .unsubscribe(&topic)
+                        .map_err(DeliveryError::UnsubscribeFailed),
+                    NodeOp::Publish {
+                        content_topic,
+                        payload,
+                    } => {
+                        let msg = WakuMessage {
+                            content_topic,
+                            payload: BASE64.encode(&payload),
+                            ephemeral: false,
+                        };
+                        match serde_json::to_string(&msg) {
+                            Ok(json) => node
+                                .send(&json)
+                                .map(|_| ())
+                                .map_err(DeliveryError::PublishFailed),
+                            Err(e) => Err(DeliveryError::PublishFailed(e.to_string())),
+                        }
+                    }
+                }
+            };
+            // Ack the caller BEFORE catch-up so the subscribe returns promptly;
+            // the catch-up then runs (serially) on this node thread.
+            let ok = result.is_ok();
             let _ = cmd.reply.try_send(result);
+            if ok {
+                if let Some((topic, start_ns)) = catch_up_topic {
+                    last_catchup.insert(topic.clone(), now_ns());
+                    // Detach: catch-up must not block the command loop (the first,
+                    // inbox subscribe can wait on the store peer connection).
+                    let node = node.clone();
+                    let subscribers = subscribers.clone();
+                    let map = map.clone();
+                    let store_peer = store_peer.clone();
+                    thread::spawn(move || {
+                        Self::store_catch_up(
+                            &node, &store_peer, &topic, start_ns, &subscribers, &map,
+                        );
+                    });
+                }
+            }
         }
 
         info!("logos-node command loop finished");
     }
+
+    /// #211: the store look-back start (ns) for a topic — a full 30-day sweep the
+    /// first time (`last == None`), else incremental from the last catch-up minus a
+    /// margin, floored at 30 days (the store peer's retention bound). Keeps the
+    /// periodic re-pull from re-replaying 30 days of history every tick.
+    fn catchup_start_ns(last: Option<u64>, now: u64) -> u64 {
+        const DAY_NS: u64 = 24 * 3600 * 1_000_000_000;
+        const MARGIN_NS: u64 = 60 * 1_000_000_000;
+        let floor = now.saturating_sub(30 * DAY_NS);
+        match last {
+            None => floor,
+            Some(t) => t.saturating_sub(MARGIN_NS).max(floor),
+        }
+    }
+
+    /// Replay history for `content_topic` from the store `peer` over the window
+    /// [`start_ns`, now] so a client whose filter subscription was dormant still
+    /// receives what it missed (#228 missed-welcome catch-up; #211 periodic pull).
+    /// Best-effort — never fails the caller. Runs on a detached thread; each
+    /// recovered message is fed through the SAME mapper + inbound fan-out as a live
+    /// message, so MLS de-dupes replays and an already-seen message is benign.
+    fn store_catch_up<F>(
+        node: &LogosNodeCtx,
+        peer: &str,
+        content_topic: &str,
+        start_ns: u64,
+        subscribers: &SubscriberList<T>,
+        map: &Arc<Mutex<F>>,
+    ) where
+        T: Clone,
+        F: FnMut(WakuEvent) -> Option<T>,
+    {
+        if peer.is_empty() {
+            return; // preset/fleet mode has no designated store peer
+        }
+        use std::time::{SystemTime, UNIX_EPOCH};
+        let now_ns = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|d| d.as_nanos() as u64)
+            .unwrap_or(0);
+        // #211: [start_ns, end_ns] window — start supplied by the caller (30-day
+        // sweep on first catch-up, incremental on periodic re-pulls).
+        let end_ns = now_ns.saturating_add(3600 * 1_000_000_000);
+        // PROVEN on-device (2026-07-26): query by contentTopics only (NO
+        // pubsubTopic — that filter silently returns 0) plus a time window.
+        let query = serde_json::json!({
+            "requestId": new_request_id(),
+            "includeData": true,
+            "contentTopics": [content_topic],
+            "timeStart": start_ns,
+            "timeEnd": end_ns,
+            "paginationLimit": 50,
+            "paginationForward": false,
+        })
+        .to_string();
+
+        // One retry: the first subscribe can land before the store peer connection
+        // is fully up; the 15s request timeout usually absorbs the dial.
+        let mut resp = None;
+        for attempt in 0..2 {
+            match node.store_query(&query, peer, 15_000) {
+                Ok(r) => {
+                    resp = Some(r);
+                    break;
+                }
+                Err(e) => {
+                    debug!("store catch-up query failed (attempt {attempt}): {e}");
+                    if attempt == 0 {
+                        thread::sleep(Duration::from_secs(3));
+                    }
+                }
+            }
+        }
+        let Some(resp) = resp else { return };
+        let parsed: StoreResponse = match serde_json::from_str(&resp) {
+            Ok(p) => p,
+            Err(e) => {
+                debug!("store catch-up parse failed: {e}");
+                return;
+            }
+        };
+        if parsed.status_code != Some(200) {
+            debug!("store catch-up non-200: {:?}", parsed.status_code);
+            return;
+        }
+        let messages = parsed.messages.unwrap_or_default();
+        let mut replayed = 0usize;
+        for entry in messages {
+            let Some(m) = entry.message else { continue };
+            let (Some(ct), Some(payload)) = (m.content_topic, m.payload) else {
+                continue;
+            };
+            // Rebuild a plain message-received event and run it through the SAME
+            // mapper the live callback uses (content-topic filter + payload
+            // decode), then fan out to the inbound queue like a live message.
+            let event = WakuEvent {
+                event_type: "message_received".to_string(),
+                message: Some(ReceivedMessage {
+                    content_topic: ct,
+                    payload,
+                }),
+                channel_id: None,
+                payload: None,
+            };
+            let item = {
+                let mut m = match map.lock() {
+                    Ok(g) => g,
+                    Err(_) => return,
+                };
+                m(event)
+            };
+            let Some(item) = item else { continue };
+            let mut guard = match subscribers.lock() {
+                Ok(g) => g,
+                Err(_) => return,
+            };
+            guard.retain(|tx| match tx.try_send(item.clone()) {
+                Ok(()) => true,
+                Err(crossbeam_channel::TrySendError::Full(_)) => true,
+                Err(crossbeam_channel::TrySendError::Disconnected(_)) => false,
+            });
+            replayed += 1;
+        }
+        if replayed > 0 {
+            info!("store catch-up: replayed {replayed} message(s) for {content_topic}");
+        }
+    }
 }
